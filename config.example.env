# O iniciar cria config.env sozinho na primeira vez. Este arquivo so documenta as opcoes.
# config.env nao vai pro git (tem o token do DuckDNS).

# RAM do servidor. 6G-8G para 10 jogadores com pack medio.
RAM=6G

# Pasta sincronizada (Google Drive) compartilhada entre os hosts. Vazio = mundo so nesta maquina.
# Windows: SYNC_DIR="G:\Meu Drive\minezada"
# Mac:     SYNC_DIR="/Users/VOCE/Library/CloudStorage/GoogleDrive-SEU_EMAIL/Meu Drive/minezada"
SYNC_DIR=

# Caminho do Java, se nao for o do PATH.
JAVA=java

# DuckDNS: o host que inicia reaponta o nome para o proprio IP. Vazio = nao atualiza.
DUCKDNS_TOKEN=
# DUCKDNS_DOMAIN=minezada-mc
