{
	chapter.7219E05592DE0419.title: "Primeiros passos"
	quest.E92EB052F9F3B141.title: "Bem-vindo ao Minezada"
	quest.E92EB052F9F3B141.quest_desc: ["Este livro guia o comeco. Abra quando quiser pelo botao do livro no inventario.", "Tecla R em cima de um item mostra a receita; U mostra para que ele serve (JEI, na direita do inventario).", "Mire em um bloco ou bicho para ver o nome e o mod no topo da tela (Jade).", "Jogo lento? Opcoes > Perfis > 1 - Minimo. Os perfis vao de 1 - Minimo a 7 - Ultra."]
	quest.0003CE0F6AE91DC0.title: "Mesa de trabalho"
	quest.0003CE0F6AE91DC0.quest_desc: ["Junte madeira e faca uma mesa de trabalho."]
	quest.0E19EE28A91186E6.title: "Mapa"
	quest.0E19EE28A91186E6.quest_desc: ["O minimapa fica no canto da tela. Tecla M abre o mapa do mundo que voce ja explorou."]
	quest.B6952285DC2B5452.title: "Mochila"
	quest.B6952285DC2B5452.quest_desc: ["Faca uma mochila: ela guarda muito mais que o inventario e pode ser melhorada."]
	quest.50A4703D190E18DE.title: "Waystone"
	quest.50A4703D190E18DE.quest_desc: ["Waystones sao pedras de teleporte. Ative uma clicando nela e depois viaje entre as que voce ativou.", "Faca a sua para colocar perto de casa."]
	quest.712E2F6300ED0812.title: "Se voce morrer"
	quest.712E2F6300ED0812.quest_desc: ["Seus itens ficam guardados em um corpo no lugar da morte. Volte la e clique nele para pegar tudo.", "O lugar da morte aparece no mapa."]
	quest.B772DD21EE451560.title: "Cozinha"
	quest.B772DD21EE451560.quest_desc: ["Farmer's Delight traz panela, tabua de corte e dezenas de comidas.", "Cada comida nova que voce prova pela primeira vez da coracoes extras de vida (Spice of Life)."]
	chapter.0196B79DB1F5EAED.title: "Create"
	quest.0BA2E8742481F590.title: "Ponder"
	quest.0BA2E8742481F590.quest_desc: ["O Create ensina cada bloco com animacoes: segure W com o mouse em cima de um item do Create."]
	quest.51E8ADCD97480966.title: "Roda d'agua"
	quest.51E8ADCD97480966.quest_desc: ["A roda d'agua gira com agua corrente e gera forca para as maquinas."]
	quest.7E848A2FACB995C9.title: "Eixos e engrenagens"
	quest.7E848A2FACB995C9.quest_desc: ["Eixos e engrenagens levam a forca da roda ate as maquinas."]
	quest.222D1DA14549BD8E.title: "Prensa"
	quest.222D1DA14549BD8E.quest_desc: ["A prensa mecanica transforma lingotes em chapas, que muitas receitas pedem."]
	chapter.55DC813E26190213.title: "Create avancado"
	quest.222DA5107B79116F.title: "Moinho de vento"
	quest.222DA5107B79116F.quest_desc: ["Rolamento de moinho com velas em volta gira sem agua. Mais velas, mais forca."]
	quest.28F379563F703E5C.title: "Misturador"
	quest.28F379563F703E5C.quest_desc: ["Misturador mecanico em cima de uma bacia mistura itens. Com aquecimento faz o latao."]
	quest.24F6C15B95927522.title: "Queimador de blaze"
	quest.24F6C15B95927522.quest_desc: ["Debaixo da bacia ele aquece as receitas. Alimente com combustivel comum."]
	quest.79F54EA46B753BB9.title: "Latao"
	quest.79F54EA46B753BB9.quest_desc: ["Cobre e zinco misturados com calor viram latao, o material das maquinas avancadas."]
	quest.E69519393E039D59.title: "Mecanismo de precisao"
	quest.E69519393E039D59.quest_desc: ["Peca das maquinas avancadas. Veja a receita em sequencia no JEI (tecla R)."]
	quest.59A5190E44EDD984.title: "Construcoes prontas"
	quest.59A5190E44EDD984.quest_desc: ["A mesa de esquemas e o canhao de esquemas (Schematicannon) montam uma construcao inteira a partir de um arquivo de esquema.", "Coloque arquivos .nbt na pasta schematics do jogo; ha milhares prontos no site createmod.com."]
	quest.604811EC769B1DFF.title: "Trens"
	quest.604811EC769B1DFF.quest_desc: ["Trilho, estacao e controles formam um trem. O Ponder (W) mostra a montagem passo a passo."]
	chapter.A5D41E448E070155.title: "Mochila e baus"
	quest.30E1A058E28935C6.title: "Base de melhoria"
	quest.30E1A058E28935C6.quest_desc: ["As melhorias da mochila partem desta base. Clique com o botao direito na mochila e coloque nas casas de melhoria."]
	quest.0DECF1890C3ABC0D.title: "Coletar sozinho"
	quest.0DECF1890C3ABC0D.quest_desc: ["A melhoria de coleta guarda direto na mochila o que voce pega do chao."]
	quest.A7310D6F4793230C.title: "Ima"
	quest.A7310D6F4793230C.quest_desc: ["A melhoria de ima puxa os itens de perto para a mochila."]
	quest.CCDCCCF2E465DD33.title: "Comer sozinho"
	quest.CCDCCCF2E465DD33.quest_desc: ["A melhoria de alimentacao come a comida da mochila quando voce fica com fome."]
	quest.4017C33CC6FCB89A.title: "Mochila de ferro"
	quest.4017C33CC6FCB89A.quest_desc: ["Mochila maior, com mais espaco e mais casas de melhoria. Depois vem ouro, diamante e netherite."]
	quest.4DD8BD036B5EA3BE.title: "Bau de ferro"
	quest.4DD8BD036B5EA3BE.quest_desc: ["Iron Chests: baus maiores que o normal. Ferro, ouro, diamante e outros."]
	quest.3B2B5BF9EDC02132.title: "Bau grande do Sophisticated"
	quest.3B2B5BF9EDC02132.quest_desc: ["Sophisticated Storage: baus e barris com melhorias, como a mochila."]
	chapter.C5E0B2A3B1354CC1.title: "Cozinha e fazenda"
	quest.444ED84B583BF94C.title: "Faca"
	quest.444ED84B583BF94C.quest_desc: ["A faca colhe palha e corta comida na tabua."]
	quest.F6DC6C83A5F3D648.title: "Tabua de corte"
	quest.F6DC6C83A5F3D648.quest_desc: ["Coloque um ingrediente na tabua e clique com a faca para cortar."]
	quest.AE7513D1359CBC3D.title: "Fogao"
	quest.AE7513D1359CBC3D.quest_desc: ["O fogao cozinha em cima e aquece a panela e a frigideira."]
	quest.5FD2BAC2E30B4AA8.title: "Terra rica"
	quest.5FD2BAC2E30B4AA8.quest_desc: ["Composto organico vira terra rica, onde as plantas crescem mais rapido."]
	quest.CB167245EDBCA310.title: "Cozinha montada"
	quest.CB167245EDBCA310.quest_desc: ["Cooking for Blockheads: a mesa de cozinha mostra tudo que da para fazer com o que esta na geladeira e nos baus ao lado."]
	quest.877424323BC65D3B.title: "Vaso que planta sozinho"
	quest.877424323BC65D3B.quest_desc: ["Botany Pots: coloque terra e uma semente; com funil embaixo ele colhe sozinho."]
	quest.53E0B8503D6C72E2.title: "Plantacao de minerio"
	quest.53E0B8503D6C72E2.quest_desc: ["Mystical Agriculture: essencia de inferium sai do minerio de inferium e vira sementes que dao materiais."]
	quest.569DF5B660B84CED.title: "Estacoes do ano"
	quest.569DF5B660B84CED.quest_desc: ["Serene Seasons: o ano tem primavera, verao, outono e inverno. Cada planta cresce melhor em certas estacoes; o JEI mostra quais."]
	chapter.9CC3B8CA7BE5A04E.title: "Construir"
	quest.379468DB3455A8B2.title: "Ferramenta de construir"
	quest.379468DB3455A8B2.quest_desc: ["Building Gadgets: coloca varios blocos de uma vez. Precisa de energia (carregue em um carregador de energia)."]
	quest.09486C4E6AFA0424.title: "Copiar e colar"
	quest.09486C4E6AFA0424.quest_desc: ["Copia uma area e cola em outro lugar, gastando os blocos do seu inventario."]
	quest.0F7DF596AAA40A64.title: "Construir com espelho"
	quest.0F7DF596AAA40A64.quest_desc: ["Effortless Building: segure Alt para escolher modos como parede, linha, espelho e repeticao."]
	quest.168A3A22661A0A48.title: "Telhados de verdade"
	quest.168A3A22661A0A48.quest_desc: ["Macaw's Roofs, Windows, Doors, Fences e Furniture: blocos de telhado, janelas, portas, cercas e moveis. Procure por mcw no JEI."]
	quest.94BD5A02E592B8A1.title: "Moveis"
	quest.94BD5A02E592B8A1.quest_desc: ["Handcrafted, Beautify, Supplementaries e Bubblellaneous trazem moveis e decoracao. Procure pelo nome do mod no JEI com @."]
	chapter.0681A168F2C7C697.title: "Animais"
	quest.F09A1A630889A48A.title: "Dicionario animal"
	quest.F09A1A630889A48A.quest_desc: ["Alex's Mobs tem um livro que explica cada bicho, o que ele come e como domesticar."]
	quest.06C980678102C2D1.title: "Banana"
	quest.06C980678102C2D1.quest_desc: ["Bananas caem das folhas de selva. Varios bichos do Alex's Mobs gostam delas, como os macacos."]
	quest.4ADAEBCD1EB47A95.title: "Hamster"
	quest.4ADAEBCD1EB47A95.quest_desc: ["Adorable Hamster Pets: hamsters de estimacao que seguem voce e cabem no ombro."]
	quest.91870977C3D93740.title: "Dragao"
	quest.91870977C3D93740.quest_desc: ["Dragon Mounts: ovos de dragao chocam um dragao que voce cria e monta."]
	quest.673908041A368C98.title: "Mais bichos"
	quest.673908041A368C98.quest_desc: ["Naturalist, Critters and Companions, Friends&Foes, Wilder Nature e Archie's Dinosaurs espalham bichos pelos biomas. O Jade mostra o nome de cada um."]
	chapter.ABBF7954E151BB6E.title: "Explorar"
	quest.876BEA6CFE9209A1.title: "Bussola de biomas"
	quest.876BEA6CFE9209A1.quest_desc: ["Nature's Compass aponta para o bioma que voce escolher."]
	quest.3062EA0B7042C34D.title: "Bussola de estruturas"
	quest.3062EA0B7042C34D.quest_desc: ["Explorer's Compass aponta para vilas, templos, masmorras e outras estruturas."]
	quest.B33B894B34D3932D.title: "Atlas"
	quest.B33B894B34D3932D.quest_desc: ["Map Atlases junta mapas de papel em um livro. Na mao secundaria vira minimapa."]
	quest.E181CF23667BE12E.title: "Pergaminho de volta"
	quest.E181CF23667BE12E.quest_desc: ["O pergaminho de retorno leva de volta para a ultima waystone ou cama."]
	chapter.59AADA362CD5A80D.title: "Mekanism"
	quest.F90F2B514D6ED05C.title: "Infusor metalurgico"
	quest.F90F2B514D6ED05C.quest_desc: ["A primeira maquina: mistura ferro com carvao para fazer aco e outras ligas. Precisa de energia."]
	quest.A8B3969DA2CBC5F3.title: "Energia"
	quest.A8B3969DA2CBC5F3.quest_desc: ["O Mekanism do pack nao tem geradores proprios: o alternador do Create Crafts & Additions transforma a rotacao do Create em energia para as maquinas."]
	quest.453A0736B216E094.title: "Camara de enriquecimento"
	quest.453A0736B216E094.quest_desc: ["Transforma um minerio em dois montes de po: o dobro de lingotes."]
	quest.993CC4C2D0BF0A31.title: "Cabos"
	quest.993CC4C2D0BF0A31.quest_desc: ["Cabos universais levam energia do gerador para as maquinas."]
	chapter.3AFA20A348928003.title: "Dimensoes"
	quest.29026A4FF6CEB946.title: "Nether"
	quest.29026A4FF6CEB946.quest_desc: ["Portal de obsidiana aceso com isqueiro."]
	quest.7155CC138F6A4CDC.title: "Aether"
	quest.7155CC138F6A4CDC.quest_desc: ["O ceu do Minecraft: moldura de pedra luminosa (glowstone) acesa com um balde de agua."]
	quest.2F383471F920B013.title: "Twilight Forest"
	quest.2F383471F920B013.quest_desc: ["Poca de agua 2x2 cercada de flores; jogue um diamante dentro."]
	quest.7B3BE44F6DE1B8AD.title: "Undergarden"
	quest.7B3BE44F6DE1B8AD.quest_desc: ["Moldura de tijolos de pedra ativada com o catalisador do Undergarden (receita no JEI)."]
	quest.932C1D9BA47BE4F2.title: "Eternal Starlight"
	quest.932C1D9BA47BE4F2.quest_desc: ["Dimensao das estrelas: procure as ruinas de portal pelo mundo e veja no JEI como ativar."]
	quest.12578001AE3297C2.title: "Masmorras infinitas"
	quest.12578001AE3297C2.quest_desc: ["Dimensional Dungeons: a chave de portal abre masmorras que se renovam (receita no JEI)."]
	quest.009843D988A83261.title: "Lua"
	quest.009843D988A83261.quest_desc: ["Ad Astra: monte um foguete na bancada da NASA e voe para a Lua."]
	quest.F8BEFEA816B93AB6.title: "End"
	quest.F8BEFEA816B93AB6.quest_desc: ["Olhos de ender levam ao portal do End e ao dragao."]
	chapter.62BEA1E66A80BAE3.title: "Aether"
	quest.EB1A452EC3CA1779.title: "Chegar no Aether"
	quest.EB1A452EC3CA1779.quest_desc: ["Moldura de glowstone acesa com um balde de agua. Leve o paraquedas dourado que o mod da na primeira visita."]
	quest.8D2620E5B1473973.title: "Ambrosium"
	quest.8D2620E5B1473973.quest_desc: ["Fragmentos de ambrosium curam e servem de combustivel no Aether."]
	quest.BB79E945D837AB5A.title: "Zanite"
	quest.BB79E945D837AB5A.quest_desc: ["Gema azul para ferramentas e armadura do Aether."]
	quest.BEDEF2172CD2B905.title: "Primeira masmorra"
	quest.BEDEF2172CD2B905.quest_desc: ["VenÃ§a o Slider na masmorra de bronze e pegue a chave de bronze."]
	quest.4AF87777C727F2E1.title: "Rainha Valquiria"
	quest.4AF87777C727F2E1.quest_desc: ["A masmorra de prata guarda a Rainha Valquiria e a chave de prata."]
	quest.A696EF3E0D6E89B7.title: "Espirito do Sol"
	quest.A696EF3E0D6E89B7.quest_desc: ["A masmorra de ouro e o fim do Aether: venÃ§a o Espirito do Sol."]
	chapter.58CDF0B4C55394C9.title: "Twilight Forest"
	quest.820B1BDC21D32332.title: "Entrar"
	quest.820B1BDC21D32332.quest_desc: ["Poca de agua 2x2 cercada de flores; jogue um diamante dentro."]
	quest.FDF21F3AFD83BEBE.title: "Naga"
	quest.FDF21F3AFD83BEBE.quest_desc: ["O primeiro chefe vive no patio de pedra. Ele deixa escamas para armadura."]
	quest.3C11C6E6C0EA5EDF.title: "Mapa magico"
	quest.3C11C6E6C0EA5EDF.quest_desc: ["Com o foco de mapa magico voce faz um mapa que mostra os biomas e as estruturas dos chefes."]
	quest.40E733CE9055A8C2.title: "Proximos chefes"
	quest.40E733CE9055A8C2.quest_desc: ["A progressao segue: Lich, Hidra, Ur-Ghast e outros. Cada chefe libera a regiao seguinte; tentar pular da efeitos ruins."]
	chapter.52600FF197F42E06.title: "Undergarden"
	quest.C9ABA829AA40AE05.title: "Catalisador"
	quest.C9ABA829AA40AE05.quest_desc: ["O catalisador ativa o portal de tijolos de pedra."]
	quest.7F65FA3D01E0FE56.title: "Entrar"
	quest.7F65FA3D01E0FE56.quest_desc: ["Undergarden e um mundo escuro e perigoso embaixo da terra. Leve tochas."]
	quest.89912EE1CD8CCEEA.title: "Cloggrum"
	quest.89912EE1CD8CCEEA.quest_desc: ["O primeiro metal do Undergarden, para ferramentas."]
	quest.2B4732C93C19A1AF.title: "Froststeel"
	quest.2B4732C93C19A1AF.quest_desc: ["Metal gelado que deixa os inimigos mais lentos."]
	quest.C92E6A440E59C51C.title: "Utherium"
	quest.C92E6A440E59C51C.quest_desc: ["Cristal forte contra as criaturas do Undergarden."]
	chapter.ECDFF22C3CFE2200.title: "Espaco"
	quest.DAD3F903CD78E4F3.title: "Aco"
	quest.DAD3F903CD78E4F3.quest_desc: ["Ad Astra comeca com aco."]
	quest.F8643149D88DB1BF.title: "Bancada da NASA"
	quest.F8643149D88DB1BF.quest_desc: ["A bancada da NASA monta as pecas do foguete."]
	quest.FB3831876F704DD4.title: "Traje espacial"
	quest.FB3831876F704DD4.quest_desc: ["Capacete e traje espacial com oxigenio sao obrigatorios fora da Terra."]
	quest.9E0708B7EA09C5FA.title: "Foguete"
	quest.9E0708B7EA09C5FA.quest_desc: ["Foguete nivel 1: leva ate a Lua. Abasteca com combustivel e coloque na plataforma de lancamento."]
	quest.72366A0DEA4B1515.title: "Lua"
	quest.72366A0DEA4B1515.quest_desc: ["Na Lua tem desh, o metal do foguete seguinte."]
	quest.CA989F85660C8492.title: "Desh"
	quest.CA989F85660C8492.quest_desc: ["Com desh voce faz o foguete nivel 2 e chega em Marte."]
	quest.6C64252B40CD4F10.title: "Marte"
	quest.6C64252B40CD4F10.quest_desc: ["Marte e o caminho para Venus, Mercurio e Glacio."]
}
