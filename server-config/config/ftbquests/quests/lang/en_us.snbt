{
	chapter_group.2A64FDD2182C23F1.title: "Começo"
	chapter_group.75C4FBF5BDDE1148.title: "Tecnologia"
	chapter_group.8B7482EA7957301C.title: "Dimensões"
	chapter_group.0723197381022D89.title: "Aventura"
	chapter.7219E05592DE0419.title: "Primeiros passos"
	chapter.7219E05592DE0419.chapter_subtitle: ["O que muda neste Minecraft e as teclas que ajudam"]
	quest.E92EB052F9F3B141.title: "Bem-vindo ao Minezada"
	quest.E92EB052F9F3B141.quest_subtitle: "Comece por aqui"
	quest.E92EB052F9F3B141.quest_desc: ["Este é o &elivro de missões&r. Ele mostra o que fazer, explica cada mod e dá prêmios: toda missão dá &aXP&r e algumas dão itens.", "", "Abra quando quiser pelo &ebotão do livro&r no canto do inventário (tecla &eE&r).", "", "Cada bolinha é uma missão. Clique nela para ler. Quando você cumpre o pedido, ela fica verde e o prêmio aparece para pegar.", "{@pagebreak}", "Os capítulos ficam na &eesquerda&r, em grupos: &aComeço&r, &aTecnologia&r, &aDimensões&r e &aAventura&r.", "", "Não precisa seguir na ordem. Quer só construir e explorar? Tudo bem. As missões são um guia, não uma obrigação.", "", "&7Clique em &fConcluir&7 para marcar esta como lida."]
	quest.A83402502454BC29.title: "Receitas: R e U"
	quest.A83402502454BC29.quest_subtitle: "A tecla mais importante"
	quest.A83402502454BC29.quest_desc: ["O pack tem centenas de itens novos. Ninguém decora receita: use o &eJEI&r, a lista de itens na direita do inventário.", "", "&eR&r com o mouse em cima de um item: mostra &acomo fazer&r.", "&eU&r com o mouse em cima de um item: mostra &aonde ele é usado&r.", "", "A barra de busca embaixo da lista aceita nome em português ou inglês, e entende erro de digitação. Comece o texto com &e@&r para ver os itens de um mod (exemplo: &e@create&r)."]
	quest.983B6AD51D05073B.title: "O que é isso?"
	quest.983B6AD51D05073B.quest_subtitle: "Jade"
	quest.983B6AD51D05073B.quest_desc: ["Mire em qualquer bloco ou bicho: o nome, o mod de onde ele vem e informações úteis aparecem no &etopo da tela&r.", "", "Serve para saber a vida de um bicho, quanto falta para uma planta crescer ou o que tem dentro de uma máquina."]
	quest.0003CE0F6AE91DC0.title: "Mesa de trabalho"
	quest.0003CE0F6AE91DC0.quest_desc: ["O começo de sempre: junte madeira e faça uma &emesa de trabalho&r.", "", "Dica: segure a tecla &eao lado do 1&r (acento grave) enquanto quebra um tronco para derrubar a árvore inteira de uma vez. Funciona com minério também (&eVeinMiner&r)."]
	quest.0E19EE28A91186E6.title: "Mapa"
	quest.0E19EE28A91186E6.quest_subtitle: "Nunca mais se perca"
	quest.0E19EE28A91186E6.quest_desc: ["O &eminimapa&r fica no canto da tela. A tecla &eM&r abre o mapa do mundo, com tudo que você já explorou.", "", "A tecla &eN&r cria um ponto marcado (waypoint) onde você está. Marque a sua casa!", "", "Outros jogadores aparecem no minimapa como cabecinhas."]
	quest.B6952285DC2B5452.title: "Mochila"
	quest.B6952285DC2B5452.quest_desc: ["Faça uma &emochila&r: ela guarda muito mais que o inventário. Clique com o botão direito segurando ela, ou coloque nas costas e abra pela tecla &eB&r.", "", "Ela ganha &aupgrades&r: coletar itens do chão, separar o que você pega, alimentar você sozinha e ficar maior (ferro, ouro, diamante). Veja no JEI com &eU&r em cima da mochila."]
	quest.50A4703D190E18DE.title: "Waystone"
	quest.50A4703D190E18DE.quest_subtitle: "Teleporte"
	quest.50A4703D190E18DE.quest_desc: ["Waystones são &epedras de teleporte&r. Elas aparecem nas vilas e pelo mundo.", "", "Clique em uma para &aativar&r. Depois, de qualquer waystone, você viaja para as que já ativou.", "", "Faça a sua e coloque perto de casa: assim você sempre volta rápido."]
	quest.712E2F6300ED0812.title: "Se você morrer"
	quest.712E2F6300ED0812.quest_desc: ["Morreu? Seus itens &enão somem&r: ficam guardados em um &ecorpo&r no lugar da morte.", "", "Volte lá e clique no corpo para pegar tudo. O lugar aparece no mapa.", "", "Esqueceu onde foi? &eAlt + U&r mostra o histórico de mortes."]
	quest.B772DD21EE451560.title: "Cozinha"
	quest.B772DD21EE451560.quest_desc: ["&eFarmer's Delight&r traz panela, frigideira, tábua de corte e dezenas de comidas.", "", "Importante: cada comida &enova&r que você prova pela primeira vez dá &acorações extras de vida&r (Spice of Life). Variar a comida deixa você mais forte!", "", "O capítulo &eCozinha e fazenda&r explica tudo."]
	quest.E11F5DC7B7E656E5.title: "Carregar baús e bichos"
	quest.E11F5DC7B7E656E5.quest_subtitle: "Carry On"
	quest.E11F5DC7B7E656E5.quest_desc: ["Com as &emãos vazias&r, segure &eShift&r e clique com o botão direito em um baú: você carrega ele inteiro, com os itens dentro.", "", "Funciona com bichos também. Ótimo para mudar de casa."]
	quest.6234896076A0B526.title: "Avisar os amigos"
	quest.6234896076A0B526.quest_subtitle: "Ping Wheel"
	quest.6234896076A0B526.quest_desc: ["Clique com o &ebotão do meio do mouse&r para marcar um ponto que todos veem: \"olha aqui\", \"perigo\", \"vem cá\"."]
	quest.35B5A51B8EC8B211.title: "Jogo lento?"
	quest.35B5A51B8EC8B211.quest_subtitle: "Perfis de gráfico"
	quest.35B5A51B8EC8B211.quest_desc: ["Em &eOpções > Perfis&r tem 7 perfis prontos: do &e1 - Mínimo&r (computador fraco) ao &e7 - Ultra&r (com shader).", "", "Clique em um e ele muda tudo na hora. Não use &cSalvar&r nem &cCriar perfil&r: pode fechar o jogo.", "", "Tecla &eK&r liga e desliga o shader."]
	quest.1C9212BF4A3DD9BC.title: "Achar uma tecla"
	quest.1C9212BF4A3DD9BC.quest_subtitle: "Controles"
	quest.1C9212BF4A3DD9BC.quest_desc: ["Em &eOpções > Controles > Teclas&r tem uma &abusca&r: digite o nome da ação (ou do mod) para ver e trocar a tecla.", "", "Tecla em vermelho está em conflito com outra."]
	chapter.BBA9B6DE266CCBFE.title: "Create 1: o basico"
	quest.F43F2D5CC50C160E.title: "O que e o Create"
	quest.F43F2D5CC50C160E.quest_desc: ["Create e um mod de maquinas que funcionam com rotacao, como um moinho de verdade: algo gira (agua, vento, vapor) e eixos levam o giro ate as maquinas.", "Segure W com o mouse em cima de qualquer item do Create para ver uma animacao explicando ele (Ponder)."]
	quest.B4E5D9F83BA191B7.title: "Liga de andesito"
	quest.B4E5D9F83BA191B7.quest_desc: ["O material de quase tudo no comeco: andesito com pepitas de ferro (ou zinco). Receita no JEI (tecla R)."]
	quest.4E782FDC8A29C55F.title: "Revestimento de andesito"
	quest.4E782FDC8A29C55F.quest_desc: ["Clique com a liga de andesito em um tronco descascado. O revestimento e a base de varias maquinas."]
	quest.713CA83B402B1EBB.title: "Eixos"
	quest.713CA83B402B1EBB.quest_desc: ["O eixo leva a rotacao em linha reta."]
	quest.F69C72DE12C48B1B.title: "Engrenagens"
	quest.F69C72DE12C48B1B.quest_desc: ["Engrenagens passam o giro para os lados. Duas engrenagens encostadas giram em sentidos opostos.", "Engrenagem grande ligada a pequena muda a velocidade: pequena para grande diminui, grande para pequena aumenta."]
	quest.06EC2EE31BBAEFB3.title: "Engrenagem grande"
	quest.06EC2EE31BBAEFB3.quest_desc: ["Junto com a pequena, ela faz curvas e muda a velocidade (RPM)."]
	quest.C95B4DD49D945339.title: "Caixa de engrenagens"
	quest.C95B4DD49D945339.quest_desc: ["Faz curvas de 90 graus em pouco espaco."]
	quest.A09FC078EB5E2BD0.title: "Manivela"
	quest.A09FC078EB5E2BD0.quest_desc: ["Gira as maquinas com a mao, para testar. Cansa: gasta fome."]
	quest.15DA37216A7BAE21.title: "Roda d'agua"
	quest.15DA37216A7BAE21.quest_desc: ["Coloque na beira de agua corrente: a agua empurra a roda e ela gira o eixo. Agua dos dois lados trava a roda."]
	quest.87DF67DB2ED1D8B5.title: "Oculos de engenheiro"
	quest.87DF67DB2ED1D8B5.quest_desc: ["Com os oculos voce olha uma maquina e ve a velocidade e o esforco (stress) dela."]
	quest.40E31D6C06C810D7.title: "Stress"
	quest.40E31D6C06C810D7.quest_desc: ["Cada maquina gasta esforco (SU). Cada fonte de giro tem um limite de SU. Passou do limite, tudo para (overstressed): coloque mais fontes ou baixe a velocidade.", "O medidor de stress mostra quanto da rede esta em uso."]
	chapter.544787426C85E4FA.title: "Create 2: primeiras maquinas"
	quest.8E9234D0A775C532.title: "Deposito"
	quest.8E9234D0A775C532.quest_desc: ["O deposito segura itens embaixo das maquinas, como uma mesa."]
	quest.A4D45AE531CC8DD4.title: "Prensa"
	quest.A4D45AE531CC8DD4.quest_desc: ["A prensa em cima de um deposito amassa lingotes em chapas. Chapas de ferro aparecem em muitas receitas."]
	quest.0FFB8A4F6D765047.title: "Chapa de ferro"
	quest.0FFB8A4F6D765047.quest_desc: ["Faca suas primeiras chapas com a prensa."]
	quest.88A9F0D3CB4E4ADF.title: "Esteira"
	quest.88A9F0D3CB4E4ADF.quest_desc: ["Feita de alga seca. Clique em dois eixos para ligar: leva itens de uma maquina para outra e tambem passa o giro."]
	quest.F7552730F917B3A2.title: "Moedor"
	quest.F7552730F917B3A2.quest_desc: ["O moedor transforma trigo em farinha e pedregulho em cascalho."]
	quest.F1902CE9B4233470.title: "Ventilador"
	quest.F1902CE9B4233470.quest_desc: ["O ventilador sopra itens. Com fogo atras ele cozinha, com lava ele derrete, com agua ele lava os itens no caminho."]
	quest.5D406386B77211CF.title: "Serra"
	quest.5D406386B77211CF.quest_desc: ["A serra corta madeira. Numa estrutura que anda, derruba arvores inteiras."]
	quest.6D0020FF08FE30D0.title: "Broca"
	quest.6D0020FF08FE30D0.quest_desc: ["A broca quebra o bloco da frente. Com rolamentos e pistoes vira uma maquina de minerar."]
	quest.D9A226648CAE99CA.title: "Moinho de vento"
	quest.D9A226648CAE99CA.quest_desc: ["O rolamento de moinho com velas em volta gira sem agua. Mais velas, mais forca. Clique no rolamento para comecar."]
	quest.B27AE96A1893C2F8.title: "Velas"
	quest.B27AE96A1893C2F8.quest_desc: ["As velas do moinho. La tambem serve."]
	quest.AB88F26A795CAB85.title: "Cola"
	quest.AB88F26A795CAB85.quest_desc: ["A super cola junta blocos para que se movam juntos numa estrutura."]
	quest.BE0E9C0DF135D391.title: "Pistao mecanico"
	quest.BE0E9C0DF135D391.quest_desc: ["Empurra uma estrutura inteira para frente e para tras."]
	quest.6E18F7126D48DC9D.title: "Rolamento mecanico"
	quest.6E18F7126D48DC9D.quest_desc: ["Gira uma estrutura inteira, como uma roda gigante ou uma porta."]
	chapter.D484F5C3EA822981.title: "Create 3: era do latao"
	quest.8600E8BC2C175FA0.title: "Bacia"
	quest.8600E8BC2C175FA0.quest_desc: ["A bacia guarda os ingredientes para o misturador e a prensa."]
	quest.13D65DA105B6DC8C.title: "Misturador"
	quest.13D65DA105B6DC8C.quest_desc: ["Em cima da bacia, com um bloco de espaco, ele mistura os ingredientes."]
	quest.35CF7E0EF578B3D8.title: "Queimador de blaze"
	quest.35CF7E0EF578B3D8.quest_desc: ["Faca o queimador vazio e clique com ele em um blaze. Embaixo da bacia ele aquece as receitas; alimente com carvao."]
	quest.B96A729DC1F49665.title: "Latao"
	quest.B96A729DC1F49665.quest_desc: ["Cobre e zinco na bacia aquecida viram latao."]
	quest.4586EE64BB7E2CB4.title: "Revestimento de latao"
	quest.4586EE64BB7E2CB4.quest_desc: ["Latao em tronco descascado. Base das maquinas avancadas."]
	quest.FE1B436601F36D12.title: "Quartzo rosa"
	quest.FE1B436601F36D12.quest_desc: ["Quartzo rosa polido vira tubo de eletrons, a peca eletronica do Create."]
	quest.5D8954105C424FBC.title: "Deployer"
	quest.5D8954105C424FBC.quest_desc: ["O deployer usa o item da mao dele no bloco da frente, como um jogador. Base da montagem automatica."]
	quest.7C28ABE1AD660519.title: "Mecanismo de precisao"
	quest.7C28ABE1AD660519.quest_desc: ["Feito em varias etapas numa esteira com deployers (montagem em sequencia). Veja o passo a passo no JEI."]
	quest.7BC3C4803FA3464F.title: "Funil de latao"
	quest.7BC3C4803FA3464F.quest_desc: ["Funis colocam e tiram itens das esteiras e baus. O de latao tem filtro."]
	quest.E8EB7FC2303C16F5.title: "Tunel de latao"
	quest.E8EB7FC2303C16F5.quest_desc: ["Divide os itens de uma esteira entre varias saidas."]
	quest.2FFCD2A06A46A4AE.title: "Crafter mecanico"
	quest.2FFCD2A06A46A4AE.quest_desc: ["Varios crafters juntos fazem receitas grandes sozinhos."]
	quest.A3F4045B66346133.title: "Britadores"
	quest.A3F4045B66346133.quest_desc: ["Duas rodas trituradoras girando para dentro moem minerio e dao mais material."]
	chapter.194556CE7AC2ADF2.title: "Create 4: vapor, fluidos e trens"
	quest.8DE1EED07292296C.title: "Tubos"
	quest.8DE1EED07292296C.quest_desc: ["Tubos levam liquidos."]
	quest.BE62D397BC09BE53.title: "Bomba"
	quest.BE62D397BC09BE53.quest_desc: ["A bomba gira e empurra o liquido pelos tubos. A chave inglesa inverte o sentido."]
	quest.65A359F59A05965E.title: "Tanque"
	quest.65A359F59A05965E.quest_desc: ["Tanques guardam liquido. Varios juntos fazem um tanque grande."]
	quest.798026F49712E18E.title: "Bico"
	quest.798026F49712E18E.quest_desc: ["O bico (spout) enche itens com liquido, como garrafas e baldes."]
	quest.8C36E8C89CCC2873.title: "Motor a vapor"
	quest.8C36E8C89CCC2873.quest_desc: ["Tanque com agua em cima de queimadores de blaze vira caldeira; o motor a vapor no tanque da muita forca."]
	quest.460D354F7E365880.title: "Trilhos"
	quest.460D354F7E365880.quest_desc: ["Os trilhos do Create fazem curvas grandes e subidas."]
	quest.C6081E1978904BB1.title: "Estacao"
	quest.C6081E1978904BB1.quest_desc: ["A estacao e onde o trem para e e montado."]
	quest.AC8228681581CCD1.title: "Controles"
	quest.AC8228681581CCD1.quest_desc: ["Os controles dirigem o trem. Com um horario, ele anda sozinho entre estacoes."]
	quest.41487192176AFECF.title: "Construcoes prontas"
	quest.41487192176AFECF.quest_desc: ["A mesa de esquemas e o canhao de esquemas montam uma construcao inteira a partir de um arquivo. Coloque arquivos .nbt na pasta schematics do jogo; ha muitos prontos no site createmod.com."]
	chapter.A5D41E448E070155.title: "Mochila e baus"
	quest.30E1A058E28935C6.title: "Base de melhoria"
	quest.30E1A058E28935C6.quest_desc: ["As melhorias da mochila partem desta base. Clique com o botao direito na mochila e coloque nas casas de melhoria."]
	quest.0DECF1890C3ABC0D.title: "Coletar sozinho"
	quest.0DECF1890C3ABC0D.quest_desc: ["A melhoria de coleta guarda direto na mochila o que voce pega do chao."]
	quest.A7310D6F4793230C.title: "Ima"
	quest.A7310D6F4793230C.quest_desc: ["A melhoria de ima puxa os itens de perto para a mochila."]
	quest.CCDCCCF2E465DD33.title: "Comer sozinho"
	quest.CCDCCCF2E465DD33.quest_desc: ["A melhoria de alimentacao come a comida da mochila quando voce fica com fome."]
	quest.4017C33CC6FCB89A.title: "Mochila de ferro"
	quest.4017C33CC6FCB89A.quest_desc: ["Mochila maior, com mais espaco e mais casas de melhoria. Depois vem ouro, diamante e netherite."]
	quest.4DD8BD036B5EA3BE.title: "Bau de ferro"
	quest.4DD8BD036B5EA3BE.quest_desc: ["Iron Chests: baus maiores que o normal. Ferro, ouro, diamante e outros."]
	quest.3B2B5BF9EDC02132.title: "Bau grande do Sophisticated"
	quest.3B2B5BF9EDC02132.quest_desc: ["Sophisticated Storage: baus e barris com melhorias, como a mochila."]
	chapter.C5E0B2A3B1354CC1.title: "Cozinha e fazenda"
	quest.444ED84B583BF94C.title: "Faca"
	quest.444ED84B583BF94C.quest_desc: ["A faca colhe palha e corta comida na tabua."]
	quest.F6DC6C83A5F3D648.title: "Tabua de corte"
	quest.F6DC6C83A5F3D648.quest_desc: ["Coloque um ingrediente na tabua e clique com a faca para cortar."]
	quest.AE7513D1359CBC3D.title: "Fogao"
	quest.AE7513D1359CBC3D.quest_desc: ["O fogao cozinha em cima e aquece a panela e a frigideira."]
	quest.5FD2BAC2E30B4AA8.title: "Terra rica"
	quest.5FD2BAC2E30B4AA8.quest_desc: ["Composto organico vira terra rica, onde as plantas crescem mais rapido."]
	quest.CB167245EDBCA310.title: "Cozinha montada"
	quest.CB167245EDBCA310.quest_desc: ["Cooking for Blockheads: a mesa de cozinha mostra tudo que da para fazer com o que esta na geladeira e nos baus ao lado."]
	quest.877424323BC65D3B.title: "Vaso que planta sozinho"
	quest.877424323BC65D3B.quest_desc: ["Botany Pots: coloque terra e uma semente; com funil embaixo ele colhe sozinho."]
	quest.53E0B8503D6C72E2.title: "Plantacao de minerio"
	quest.53E0B8503D6C72E2.quest_desc: ["Mystical Agriculture: essencia de inferium sai do minerio de inferium e vira sementes que dao materiais."]
	quest.569DF5B660B84CED.title: "Estacoes do ano"
	quest.569DF5B660B84CED.quest_desc: ["Serene Seasons: o ano tem primavera, verao, outono e inverno. Cada planta cresce melhor em certas estacoes; o JEI mostra quais."]
	chapter.9CC3B8CA7BE5A04E.title: "Construir"
	quest.379468DB3455A8B2.title: "Ferramenta de construir"
	quest.379468DB3455A8B2.quest_desc: ["Building Gadgets: coloca varios blocos de uma vez. Precisa de energia (carregue em um carregador de energia)."]
	quest.09486C4E6AFA0424.title: "Copiar e colar"
	quest.09486C4E6AFA0424.quest_desc: ["Copia uma area e cola em outro lugar, gastando os blocos do seu inventario."]
	quest.0F7DF596AAA40A64.title: "Construir com espelho"
	quest.0F7DF596AAA40A64.quest_desc: ["Effortless Building: segure Alt para escolher modos como parede, linha, espelho e repeticao."]
	quest.168A3A22661A0A48.title: "Telhados de verdade"
	quest.168A3A22661A0A48.quest_desc: ["Macaw's Roofs, Windows, Doors, Fences e Furniture: blocos de telhado, janelas, portas, cercas e moveis. Procure por mcw no JEI."]
	quest.94BD5A02E592B8A1.title: "Moveis"
	quest.94BD5A02E592B8A1.quest_desc: ["Handcrafted, Beautify, Supplementaries e Bubblellaneous trazem moveis e decoracao. Procure pelo nome do mod no JEI com @."]
	chapter.0681A168F2C7C697.title: "Animais"
	quest.F09A1A630889A48A.title: "Dicionario animal"
	quest.F09A1A630889A48A.quest_desc: ["Alex's Mobs tem um livro que explica cada bicho, o que ele come e como domesticar."]
	quest.06C980678102C2D1.title: "Banana"
	quest.06C980678102C2D1.quest_desc: ["Bananas caem das folhas de selva. Varios bichos do Alex's Mobs gostam delas, como os macacos."]
	quest.4ADAEBCD1EB47A95.title: "Hamster"
	quest.4ADAEBCD1EB47A95.quest_desc: ["Adorable Hamster Pets: hamsters de estimacao que seguem voce e cabem no ombro."]
	quest.91870977C3D93740.title: "Dragao"
	quest.91870977C3D93740.quest_desc: ["Dragon Mounts: ovos de dragao chocam um dragao que voce cria e monta."]
	quest.673908041A368C98.title: "Mais bichos"
	quest.673908041A368C98.quest_desc: ["Naturalist, Critters and Companions, Friends&Foes, Wilder Nature e Archie's Dinosaurs espalham bichos pelos biomas. O Jade mostra o nome de cada um."]
	chapter.ABBF7954E151BB6E.title: "Explorar"
	quest.876BEA6CFE9209A1.title: "Bussola de biomas"
	quest.876BEA6CFE9209A1.quest_desc: ["Nature's Compass aponta para o bioma que voce escolher."]
	quest.3062EA0B7042C34D.title: "Bussola de estruturas"
	quest.3062EA0B7042C34D.quest_desc: ["Explorer's Compass aponta para vilas, templos, masmorras e outras estruturas."]
	quest.B33B894B34D3932D.title: "Atlas"
	quest.B33B894B34D3932D.quest_desc: ["Map Atlases junta mapas de papel em um livro. Na mao secundaria vira minimapa."]
	quest.E181CF23667BE12E.title: "Pergaminho de volta"
	quest.E181CF23667BE12E.quest_desc: ["O pergaminho de retorno leva de volta para a ultima waystone ou cama."]
	chapter.59AADA362CD5A80D.title: "Mekanism"
	quest.F90F2B514D6ED05C.title: "Infusor metalurgico"
	quest.F90F2B514D6ED05C.quest_desc: ["A primeira maquina: mistura ferro com carvao para fazer aco e outras ligas. Precisa de energia."]
	quest.A8B3969DA2CBC5F3.title: "Energia"
	quest.A8B3969DA2CBC5F3.quest_desc: ["O Mekanism do pack nao tem geradores proprios: o alternador do Create Crafts & Additions transforma a rotacao do Create em energia para as maquinas."]
	quest.453A0736B216E094.title: "Camara de enriquecimento"
	quest.453A0736B216E094.quest_desc: ["Transforma um minerio em dois montes de po: o dobro de lingotes."]
	quest.993CC4C2D0BF0A31.title: "Cabos"
	quest.993CC4C2D0BF0A31.quest_desc: ["Cabos universais levam energia do gerador para as maquinas."]
