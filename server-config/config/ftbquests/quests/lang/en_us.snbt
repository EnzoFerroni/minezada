	quest.BEDEF2172CD2B905.quest_desc: ["Venca o Slider na masmorra de bronze e pegue a chave de bronze."]
	quest.4AF87777C727F2E1.title: "Rainha Valquiria"
	quest.4AF87777C727F2E1.quest_desc: ["A masmorra de prata guarda a Rainha Valquiria e a chave de prata."]
	quest.A696EF3E0D6E89B7.title: "Espirito do Sol"
	quest.A696EF3E0D6E89B7.quest_desc: ["A masmorra de ouro e o fim do Aether: venca o Espirito do Sol."]
	chapter.58CDF0B4C55394C9.title: "Twilight Forest"
	quest.820B1BDC21D32332.title: "Entrar"
	quest.820B1BDC21D32332.quest_desc: ["Poca de agua 2x2 cercada de flores; jogue um diamante dentro."]
	quest.FDF21F3AFD83BEBE.title: "Naga"
	quest.FDF21F3AFD83BEBE.quest_desc: ["O primeiro chefe vive no patio de pedra. Ele deixa escamas para armadura."]
