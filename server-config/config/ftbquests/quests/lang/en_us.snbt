{
	chapter_group.2A64FDD2182C23F1.title: "Começo"
	chapter_group.75C4FBF5BDDE1148.title: "Tecnologia"
	chapter_group.0B7482EA7957301C.title: "Dimensões"
	chapter_group.0723197381022D89.title: "Aventura"
	chapter.7219E05592DE0419.title: "Primeiros passos"
	chapter.7219E05592DE0419.chapter_subtitle: ["O que muda neste Minecraft e as teclas que ajudam"]
	quest.692EB052F9F3B141.title: "Bem-vindo ao Minezada"
	quest.692EB052F9F3B141.quest_subtitle: "Comece por aqui"
	quest.692EB052F9F3B141.quest_desc: ["Este é o &elivro de missões&r. Ele mostra o que fazer, explica cada mod e dá prêmios: toda missão dá &aXP&r e algumas dão itens.", "", "Abra quando quiser pelo &ebotão do livro&r no canto do inventário (tecla &eE&r).", "", "Cada bolinha é uma missão. Clique nela para ler. Quando você cumpre o pedido, ela fica verde e o prêmio aparece para pegar.", "{@pagebreak}", "Os capítulos ficam na &eesquerda&r, em grupos: &aComeço&r, &aTecnologia&r, &aDimensões&r e &aAventura&r.", "", "Não precisa seguir na ordem. Quer só construir e explorar? Tudo bem. As missões são um guia, não uma obrigação.", "", "&7Clique em &fConcluir&7 para marcar esta como lida."]
	quest.283402502454BC29.title: "Receitas: R e U"
	quest.283402502454BC29.quest_subtitle: "A tecla mais importante"
	quest.283402502454BC29.quest_desc: ["O pack tem centenas de itens novos. Ninguém decora receita: use o &eJEI&r, a lista de itens na direita do inventário.", "", "&eR&r com o mouse em cima de um item: mostra &acomo fazer&r.", "&eU&r com o mouse em cima de um item: mostra &aonde ele é usado&r.", "", "A barra de busca embaixo da lista aceita nome em português ou inglês, e entende erro de digitação. Comece o texto com &e@&r para ver os itens de um mod (exemplo: &e@create&r)."]
	quest.183B6AD51D05073B.title: "O que é isso?"
	quest.183B6AD51D05073B.quest_subtitle: "Jade"
	quest.183B6AD51D05073B.quest_desc: ["Mire em qualquer bloco ou bicho: o nome, o mod de onde ele vem e informações úteis aparecem no &etopo da tela&r.", "", "Serve para saber a vida de um bicho, quanto falta para uma planta crescer ou o que tem dentro de uma máquina."]
	quest.0003CE0F6AE91DC0.title: "Mesa de trabalho"
	quest.0003CE0F6AE91DC0.quest_desc: ["O começo de sempre: junte madeira e faça uma &emesa de trabalho&r.", "", "Dica: segure a tecla &eao lado do 1&r (acento grave) enquanto quebra um tronco para derrubar a árvore inteira de uma vez. Funciona com minério também (&eVeinMiner&r)."]
	quest.0E19EE28A91186E6.title: "Mapa"
	quest.0E19EE28A91186E6.quest_subtitle: "Nunca mais se perca"
	quest.0E19EE28A91186E6.quest_desc: ["O &eminimapa&r fica no canto da tela. A tecla &eM&r abre o mapa do mundo, com tudo que você já explorou.", "", "A tecla &eN&r cria um ponto marcado (waypoint) onde você está. Marque a sua casa!", "", "Outros jogadores aparecem no minimapa como cabecinhas."]
	quest.36952285DC2B5452.title: "Mochila"
	quest.36952285DC2B5452.quest_desc: ["Faça uma &emochila&r: ela guarda muito mais que o inventário. Clique com o botão direito segurando ela, ou coloque nas costas e abra pela tecla &eB&r.", "", "Ela ganha &aupgrades&r: coletar itens do chão, separar o que você pega, alimentar você sozinha e ficar maior (ferro, ouro, diamante). Veja no JEI com &eU&r em cima da mochila."]
	quest.50A4703D190E18DE.title: "Waystone"
	quest.50A4703D190E18DE.quest_subtitle: "Teleporte"
	quest.50A4703D190E18DE.quest_desc: ["Waystones são &epedras de teleporte&r. Elas aparecem nas vilas e pelo mundo.", "", "Clique em uma para &aativar&r. Depois, de qualquer waystone, você viaja para as que já ativou.", "", "Faça a sua e coloque perto de casa: assim você sempre volta rápido."]
	quest.712E2F6300ED0812.title: "Se você morrer"
	quest.712E2F6300ED0812.quest_desc: ["Morreu? Seus itens &enão somem&r: ficam guardados em um &ecorpo&r no lugar da morte.", "", "Volte lá e clique no corpo para pegar tudo. O lugar aparece no mapa.", "", "Esqueceu onde foi? &eAlt + U&r mostra o histórico de mortes."]
	quest.3772DD21EE451560.title: "Cozinha"
	quest.3772DD21EE451560.quest_desc: ["&eFarmer's Delight&r traz panela, frigideira, tábua de corte e dezenas de comidas.", "", "Importante: cada comida &enova&r que você prova pela primeira vez dá &acorações extras de vida&r (Spice of Life). Variar a comida deixa você mais forte!", "", "O capítulo &eCozinha e fazenda&r explica tudo."]
	quest.611F5DC7B7E656E5.title: "Carregar baús e bichos"
	quest.611F5DC7B7E656E5.quest_subtitle: "Carry On"
	quest.611F5DC7B7E656E5.quest_desc: ["Com as &emãos vazias&r, segure &eShift&r e clique com o botão direito em um baú: você carrega ele inteiro, com os itens dentro.", "", "Funciona com bichos também. Ótimo para mudar de casa."]
	quest.6234896076A0B526.title: "Avisar os amigos"
	quest.6234896076A0B526.quest_subtitle: "Ping Wheel"
	quest.6234896076A0B526.quest_desc: ["Clique com o &ebotão do meio do mouse&r para marcar um ponto que todos veem: \"olha aqui\", \"perigo\", \"vem cá\"."]
	quest.35B5A51B8EC8B211.title: "Jogo lento?"
	quest.35B5A51B8EC8B211.quest_subtitle: "Perfis de gráfico"
	quest.35B5A51B8EC8B211.quest_desc: ["Em &eOpções > Perfis&r tem 7 perfis prontos: do &e1 - Mínimo&r (computador fraco) ao &e7 - Ultra&r (com shader).", "", "Clique em um e ele muda tudo na hora. Não use &cSalvar&r nem &cCriar perfil&r: pode fechar o jogo.", "", "Tecla &eK&r liga e desliga o shader."]
	quest.1C9212BF4A3DD9BC.title: "Achar uma tecla"
	quest.1C9212BF4A3DD9BC.quest_subtitle: "Controles"
	quest.1C9212BF4A3DD9BC.quest_desc: ["Em &eOpções > Controles > Teclas&r tem uma &abusca&r: digite o nome da ação (ou do mod) para ver e trocar a tecla.", "", "Tecla em vermelho está em conflito com outra."]
	chapter.3BA9B6DE266CCBFE.title: "Create 1: o basico"
	quest.743F2D5CC50C160E.title: "O que e o Create"
	quest.743F2D5CC50C160E.quest_desc: ["Create e um mod de maquinas que funcionam com rotacao, como um moinho de verdade: algo gira (agua, vento, vapor) e eixos levam o giro ate as maquinas.", "Segure W com o mouse em cima de qualquer item do Create para ver uma animacao explicando ele (Ponder)."]
	quest.34E5D9F83BA191B7.title: "Liga de andesito"
	quest.34E5D9F83BA191B7.quest_desc: ["O material de quase tudo no comeco: andesito com pepitas de ferro (ou zinco). Receita no JEI (tecla R)."]
	quest.4E782FDC8A29C55F.title: "Revestimento de andesito"
	quest.4E782FDC8A29C55F.quest_desc: ["Clique com a liga de andesito em um tronco descascado. O revestimento e a base de varias maquinas."]
	quest.713CA83B402B1EBB.title: "Eixos"
	quest.713CA83B402B1EBB.quest_desc: ["O eixo leva a rotacao em linha reta."]
	quest.769C72DE12C48B1B.title: "Engrenagens"
	quest.769C72DE12C48B1B.quest_desc: ["Engrenagens passam o giro para os lados. Duas engrenagens encostadas giram em sentidos opostos.", "Engrenagem grande ligada a pequena muda a velocidade: pequena para grande diminui, grande para pequena aumenta."]
	quest.06EC2EE31BBAEFB3.title: "Engrenagem grande"
	quest.06EC2EE31BBAEFB3.quest_desc: ["Junto com a pequena, ela faz curvas e muda a velocidade (RPM)."]
	quest.495B4DD49D945339.title: "Caixa de engrenagens"
	quest.495B4DD49D945339.quest_desc: ["Faz curvas de 90 graus em pouco espaco."]
	quest.209FC078EB5E2BD0.title: "Manivela"
	quest.209FC078EB5E2BD0.quest_desc: ["Gira as maquinas com a mao, para testar. Cansa: gasta fome."]
	quest.15DA37216A7BAE21.title: "Roda d'agua"
	quest.15DA37216A7BAE21.quest_desc: ["Coloque na beira de agua corrente: a agua empurra a roda e ela gira o eixo. Agua dos dois lados trava a roda."]
	quest.07DF67DB2ED1D8B5.title: "Oculos de engenheiro"
	quest.07DF67DB2ED1D8B5.quest_desc: ["Com os oculos voce olha uma maquina e ve a velocidade e o esforco (stress) dela."]
	quest.40E31D6C06C810D7.title: "Stress"
	quest.40E31D6C06C810D7.quest_desc: ["Cada maquina gasta esforco (SU). Cada fonte de giro tem um limite de SU. Passou do limite, tudo para (overstressed): coloque mais fontes ou baixe a velocidade.", "O medidor de stress mostra quanto da rede esta em uso."]
	chapter.544787426C85E4FA.title: "Create 2: primeiras maquinas"
	quest.0E9234D0A775C532.title: "Deposito"
	quest.0E9234D0A775C532.quest_desc: ["O deposito segura itens embaixo das maquinas, como uma mesa."]
	quest.24D45AE531CC8DD4.title: "Prensa"
	quest.24D45AE531CC8DD4.quest_desc: ["A prensa em cima de um deposito amassa lingotes em chapas. Chapas de ferro aparecem em muitas receitas."]
	quest.0FFB8A4F6D765047.title: "Chapa de ferro"
	quest.0FFB8A4F6D765047.quest_desc: ["Faca suas primeiras chapas com a prensa."]
	quest.08A9F0D3CB4E4ADF.title: "Esteira"
	quest.08A9F0D3CB4E4ADF.quest_desc: ["Feita de alga seca. Clique em dois eixos para ligar: leva itens de uma maquina para outra e tambem passa o giro."]
	quest.77552730F917B3A2.title: "Moedor"
	quest.77552730F917B3A2.quest_desc: ["O moedor transforma trigo em farinha e pedregulho em cascalho."]
	quest.71902CE9B4233470.title: "Ventilador"
	quest.71902CE9B4233470.quest_desc: ["O ventilador sopra itens. Com fogo atras ele cozinha, com lava ele derrete, com agua ele lava os itens no caminho."]
	quest.5D406386B77211CF.title: "Serra"
	quest.5D406386B77211CF.quest_desc: ["A serra corta madeira. Numa estrutura que anda, derruba arvores inteiras."]
	quest.6D0020FF08FE30D0.title: "Broca"
	quest.6D0020FF08FE30D0.quest_desc: ["A broca quebra o bloco da frente. Com rolamentos e pistoes vira uma maquina de minerar."]
	quest.59A226648CAE99CA.title: "Moinho de vento"
	quest.59A226648CAE99CA.quest_desc: ["O rolamento de moinho com velas em volta gira sem agua. Mais velas, mais forca. Clique no rolamento para comecar."]
	quest.327AE96A1893C2F8.title: "Velas"
	quest.327AE96A1893C2F8.quest_desc: ["As velas do moinho. La tambem serve."]
	quest.2B88F26A795CAB85.title: "Cola"
	quest.2B88F26A795CAB85.quest_desc: ["A super cola junta blocos para que se movam juntos numa estrutura."]
	quest.3E0E9C0DF135D391.title: "Pistao mecanico"
	quest.3E0E9C0DF135D391.quest_desc: ["Empurra uma estrutura inteira para frente e para tras."]
	quest.6E18F7126D48DC9D.title: "Rolamento mecanico"
	quest.6E18F7126D48DC9D.quest_desc: ["Gira uma estrutura inteira, como uma roda gigante ou uma porta."]
	chapter.5484F5C3EA822981.title: "Create 3: era do latao"
	quest.0600E8BC2C175FA0.title: "Bacia"
	quest.0600E8BC2C175FA0.quest_desc: ["A bacia guarda os ingredientes para o misturador e a prensa."]
	quest.13D65DA105B6DC8C.title: "Misturador"
	quest.13D65DA105B6DC8C.quest_desc: ["Em cima da bacia, com um bloco de espaco, ele mistura os ingredientes."]
	quest.35CF7E0EF578B3D8.title: "Queimador de blaze"
	quest.35CF7E0EF578B3D8.quest_desc: ["Faca o queimador vazio e clique com ele em um blaze. Embaixo da bacia ele aquece as receitas; alimente com carvao."]
	quest.396A729DC1F49665.title: "Latao"
	quest.396A729DC1F49665.quest_desc: ["Cobre e zinco na bacia aquecida viram latao."]
	quest.4586EE64BB7E2CB4.title: "Revestimento de latao"
	quest.4586EE64BB7E2CB4.quest_desc: ["Latao em tronco descascado. Base das maquinas avancadas."]
	quest.7E1B436601F36D12.title: "Quartzo rosa"
	quest.7E1B436601F36D12.quest_desc: ["Quartzo rosa polido vira tubo de eletrons, a peca eletronica do Create."]
	quest.5D8954105C424FBC.title: "Deployer"
	quest.5D8954105C424FBC.quest_desc: ["O deployer usa o item da mao dele no bloco da frente, como um jogador. Base da montagem automatica."]
	quest.7C28ABE1AD660519.title: "Mecanismo de precisao"
	quest.7C28ABE1AD660519.quest_desc: ["Feito em varias etapas numa esteira com deployers (montagem em sequencia). Veja o passo a passo no JEI."]
	quest.7BC3C4803FA3464F.title: "Funil de latao"
	quest.7BC3C4803FA3464F.quest_desc: ["Funis colocam e tiram itens das esteiras e baus. O de latao tem filtro."]
	quest.68EB7FC2303C16F5.title: "Tunel de latao"
	quest.68EB7FC2303C16F5.quest_desc: ["Divide os itens de uma esteira entre varias saidas."]
	quest.2FFCD2A06A46A4AE.title: "Crafter mecanico"
	quest.2FFCD2A06A46A4AE.quest_desc: ["Varios crafters juntos fazem receitas grandes sozinhos."]
	quest.23F4045B66346133.title: "Britadores"
	quest.23F4045B66346133.quest_desc: ["Duas rodas trituradoras girando para dentro moem minerio e dao mais material."]
	chapter.194556CE7AC2ADF2.title: "Create 4: vapor, fluidos e trens"
	quest.0DE1EED07292296C.title: "Tubos"
	quest.0DE1EED07292296C.quest_desc: ["Tubos levam liquidos."]
	quest.3E62D397BC09BE53.title: "Bomba"
	quest.3E62D397BC09BE53.quest_desc: ["A bomba gira e empurra o liquido pelos tubos. A chave inglesa inverte o sentido."]
	quest.65A359F59A05965E.title: "Tanque"
	quest.65A359F59A05965E.quest_desc: ["Tanques guardam liquido. Varios juntos fazem um tanque grande."]
	quest.798026F49712E18E.title: "Bico"
	quest.798026F49712E18E.quest_desc: ["O bico (spout) enche itens com liquido, como garrafas e baldes."]
	quest.0C36E8C89CCC2873.title: "Motor a vapor"
	quest.0C36E8C89CCC2873.quest_desc: ["Tanque com agua em cima de queimadores de blaze vira caldeira; o motor a vapor no tanque da muita forca."]
	quest.460D354F7E365880.title: "Trilhos"
	quest.460D354F7E365880.quest_desc: ["Os trilhos do Create fazem curvas grandes e subidas."]
	quest.46081E1978904BB1.title: "Estacao"
	quest.46081E1978904BB1.quest_desc: ["A estacao e onde o trem para e e montado."]
	quest.2C8228681581CCD1.title: "Controles"
	quest.2C8228681581CCD1.quest_desc: ["Os controles dirigem o trem. Com um horario, ele anda sozinho entre estacoes."]
	quest.41487192176AFECF.title: "Construcoes prontas"
	quest.41487192176AFECF.quest_desc: ["A mesa de esquemas e o canhao de esquemas montam uma construcao inteira a partir de um arquivo. Coloque arquivos .nbt na pasta schematics do jogo; ha muitos prontos no site createmod.com."]
	chapter.25D41E448E070155.title: "Mochila e baus"
	quest.30E1A058E28935C6.title: "Base de melhoria"
	quest.30E1A058E28935C6.quest_desc: ["As melhorias da mochila partem desta base. Clique com o botao direito na mochila e coloque nas casas de melhoria."]
	quest.0DECF1890C3ABC0D.title: "Coletar sozinho"
	quest.0DECF1890C3ABC0D.quest_desc: ["A melhoria de coleta guarda direto na mochila o que voce pega do chao."]
	quest.27310D6F4793230C.title: "Ima"
	quest.27310D6F4793230C.quest_desc: ["A melhoria de ima puxa os itens de perto para a mochila."]
	quest.4CDCCCF2E465DD33.title: "Comer sozinho"
	quest.4CDCCCF2E465DD33.quest_desc: ["A melhoria de alimentacao come a comida da mochila quando voce fica com fome."]
	quest.4017C33CC6FCB89A.title: "Mochila de ferro"
	quest.4017C33CC6FCB89A.quest_desc: ["Mochila maior, com mais espaco e mais casas de melhoria. Depois vem ouro, diamante e netherite."]
	quest.4DD8BD036B5EA3BE.title: "Bau de ferro"
	quest.4DD8BD036B5EA3BE.quest_desc: ["Iron Chests: baus maiores que o normal. Ferro, ouro, diamante e outros."]
	quest.3B2B5BF9EDC02132.title: "Bau grande do Sophisticated"
	quest.3B2B5BF9EDC02132.quest_desc: ["Sophisticated Storage: baus e barris com melhorias, como a mochila."]
	chapter.45E0B2A3B1354CC1.title: "Cozinha e fazenda"
	chapter.45E0B2A3B1354CC1.chapter_subtitle: ["Comer bem deixa você mais forte"]
	quest.1A06C261319C8017.title: "Variedade dá vida"
	quest.1A06C261319C8017.quest_subtitle: "Spice of Life"
	quest.1A06C261319C8017.quest_desc: ["Comer sempre a mesma coisa não compensa: cada comida &enova&r que você prova pela primeira vez dá &acorações extras para sempre&r.", "", "Passe o mouse em uma comida: o texto diz se você já comeu. Segure uma comida para ver na barra de fome quanto ela enche (&eAppleSkin&r).", "", "Duas receitas com os mesmos ingredientes? Um botão aparece em cima do resultado para escolher qual fazer (&ePolymorph&r)."]
	quest.444ED84B583BF94C.title: "Faca"
	quest.444ED84B583BF94C.quest_subtitle: "Farmer's Delight"
	quest.444ED84B583BF94C.quest_desc: ["A cozinha do &eFarmer's Delight&r começa com uma &efaca&r. A mais simples é de sílex e graveto.", "", "Segredo: quebre &egrama alta&r, trigo ou arroz com a faca para ganhar &apalha&r. Com a mão não cai."]
	quest.76DC6C83A5F3D648.title: "Tábua de corte"
	quest.76DC6C83A5F3D648.quest_desc: ["Coloque um ingrediente na &etábua de corte&r com o botão direito e clique de novo com a &efaca&r para fatiar carne, peixe e verdura.", "", "Funciona com outras ferramentas: um &emachado&r em um tronco na tábua dá tábuas e &acasca de árvore&r."]
	quest.2E7513D1359CBC3D.title: "Fogão"
	quest.2E7513D1359CBC3D.quest_desc: ["O &efogão&r assa até 6 comidas na chapa de cima, sem gastar carvão.", "", "É também a melhor fonte de calor para colocar a &epanela&r ou a &efrigideira&r em cima."]
	quest.0A7828646B97BEF9.title: "Cozinha"
	quest.0A7828646B97BEF9.quest_subtitle: "A panela"
	quest.0A7828646B97BEF9.quest_desc: ["Coloque a &epanela&r em cima de uma fonte de calor (fogão, fogueira ou magma) para cozinhar até 6 ingredientes juntos.", "", "Alguns pratos pedem &etigela&r ou &egarrafa&r no espaço do recipiente.", "", "Quebrou a panela com comida dentro? &aA comida vai junto&r: dá para levar em viagens."]
	quest.681E9E63CB9E3256.title: "Frigideira"
	quest.681E9E63CB9E3256.quest_desc: ["A &efrigideira&r frita uma comida por vez.", "", "No chão: coloque em cima de um fogão ou fogueira e clique com a comida.", "Na mão: perto de um fogo, segure a frigideira em uma mão e a comida crua na outra, e segure o botão direito."]
	quest.1FD0527105F03C4B.title: "Banquete"
	quest.1FD0527105F03C4B.quest_desc: ["Vários pratos grandes, como o &efrango assado&r, viram um &ebloco&r na mesa.", "", "Clique com uma &etigela&r vazia para servir uma porção. Bolos e tortas se cortam com a &efaca&r. Ótimo para dividir com os amigos."]
	quest.5FD2BAC2E30B4AA8.title: "Terra rica"
	quest.5FD2BAC2E30B4AA8.quest_subtitle: "Plantas crescem mais rápido"
	quest.5FD2BAC2E30B4AA8.quest_desc: ["O &ecomposto orgânico&r colocado no chão vira &aterra rica&r com o tempo. Fica mais rápido no sol, perto de água ou de cogumelos.", "", "Are a terra rica com a enxada: as plantas crescem &amais rápido&r e ela &anão estraga&r se alguém pular em cima."]
	quest.37A3ECE29F59CBA3.title: "Colônia de cogumelos"
	quest.37A3ECE29F59CBA3.quest_desc: ["Plante um cogumelo em cima de &eterra rica&r em lugar escuro: ele vira uma &ecolônia&r.", "", "Use a &etesoura&r nela para colher cogumelos sem destruir a colônia."]
	quest.14EA467B6FBF8668.title: "Arroz e tomate"
	quest.14EA467B6FBF8668.quest_subtitle: "Plantas diferentes"
	quest.14EA467B6FBF8668.quest_desc: ["O &earroz&r se planta na terra &edebaixo de um bloco de água&r, nunca em terra arada seca.", "", "O &etomate&r sobe por &ecorda&r: pendure corda em cima do pé para ele crescer e dar mais tomates."]
	quest.569DF5B660B84CED.title: "Estações do ano"
	quest.569DF5B660B84CED.quest_subtitle: "Serene Seasons"
	quest.569DF5B660B84CED.quest_desc: ["O mundo tem &eprimavera, verão, outono e inverno&r. No inverno os dias são mais curtos e neva.", "", "Cada planta cresce bem só em certas estações. Passe o mouse na semente para ver quais.", "", "Truque: plantação com &evidro&r em cima (estufa) ou no subsolo cresce o ano inteiro.", "", "O &ecalendário&r mostra a estação e quantos dias faltam para a próxima."]
	quest.58F6C1361EC81ECA.title: "Sensor de estação"
	quest.58F6C1361EC81ECA.quest_desc: ["O &esensor de estação&r manda sinal de &eredstone&r conforme a estação. Serve para ligar luzes ou máquinas na época certa."]
	quest.4EBD5BC9FC0C21E4.title: "Frutas do mundo"
	quest.4EBD5BC9FC0C21E4.quest_subtitle: "Croptopia"
	quest.4EBD5BC9FC0C21E4.quest_desc: ["O &eCroptopia&r espalha dezenas de frutas, verduras e árvores frutíferas pelos biomas.", "", "Achou uma planta nova? Coloque a fruta na mesa de trabalho para fazer &asementes&r. Nas árvores frutíferas, clique nas folhas maduras.", "", "O &esal&r aparece em muitas receitas: veja como fazer com &eR&r em cima dele."]
	quest.6B2F90350C948BE0.title: "Utensílios que não quebram"
	quest.6B2F90350C948BE0.quest_subtitle: "Croptopia"
	quest.6B2F90350C948BE0.quest_desc: ["O Croptopia cozinha na &emesa de trabalho&r com 5 utensílios: pilão, prensa, panela, frigideira e faca.", "", "Eles &anunca quebram&r: ficam na mesa depois de cada receita."]
	quest.69A299D53718CCB7.title: "Comida do mundo todo"
	quest.69A299D53718CCB7.quest_subtitle: "Cultural Delights"
	quest.69A299D53718CCB7.quest_desc: ["O &eCultural Delights&r traz milho, pepino, berinjela e abacate, espalhados por planícies, pântanos e selvas.", "", "O &ebarril&r do mod fermenta comidas como picles e queijo. Veja as receitas com &eU&r em cima dele."]
	quest.230395E0CA029A36.title: "Armários de cozinha"
	quest.230395E0CA029A36.quest_subtitle: "Storage Delight"
	quest.230395E0CA029A36.quest_desc: ["Gavetas, armários com porta de vidro e balcões em todas as madeiras, para a cozinha ficar organizada e bonita."]
	quest.4B167245EDBCA310.title: "Cozinha montada"
	quest.4B167245EDBCA310.quest_subtitle: "Cooking for Blockheads"
	quest.4B167245EDBCA310.quest_desc: ["A &emesa de cozinha&r mostra tudo o que dá para cozinhar com o que você tem no inventário e nos blocos ligados a ela.", "", "Encoste &egeladeira, armários, balcões e forno&r do mod na mesa (ou ligue com &episo de cozinha&r) para formar uma cozinha só.", "", "Clique em um prato da lista e ele é feito na hora, sem procurar ingrediente baú por baú."]
	quest.46998D37F658FFCC.title: "Água e leite sem fim"
	quest.46998D37F658FFCC.quest_desc: ["A &epia&r ligada à cozinha dá &aágua infinita&r para as receitas.", "", "Leite infinito: coloque um &epote de leite&r no chão, leve uma vaca para cima e derrube uma &ebigorna&r nela. Ela vira uma &evaca no pote&r."]
	quest.331FAE9299EA6A9F.title: "Melhorias da geladeira"
	quest.331FAE9299EA6A9F.quest_desc: ["Clique na geladeira com a &eunidade de gelo&r para ter gelo e neve infinitos nas receitas.", "", "Veja as outras melhorias do forno e da geladeira com &eU&r em cima delas."]
	quest.560E86939E9F32B8.title: "Vaso de planta"
	quest.560E86939E9F32B8.quest_subtitle: "Botany Pots"
	quest.560E86939E9F32B8.quest_desc: ["O &evaso&r planta lavoura e até árvore em &aum bloco só&r, dentro de casa e sem água.", "", "Coloque terra dentro (areia para cacto), depois a semente. Quando crescer, clique para colher.", "", "Terra rica dentro do vaso faz crescer mais rápido."]
	quest.06056D73419282AF.title: "Vaso que colhe sozinho"
	quest.06056D73419282AF.quest_subtitle: "Botany Pots"
	quest.06056D73419282AF.quest_desc: ["O &evaso com funil&r colhe e replanta &asozinho para sempre&r. Coloque em cima de um baú: a colheita vai para dentro.", "", "Dez vasos desses em cima de baús viram uma fazenda que nunca para."]
	quest.1FF26F89EA731135.title: "Comida de viagem"
	quest.1FF26F89EA731135.quest_subtitle: "Ocean's, End's e Twilight Delight"
	quest.1FF26F89EA731135.quest_desc: ["Explorar libera pratos novos com efeitos bons:", "&eOcean's Delight&r: lula, baiacu e sopas do mar.", "&eEnd's Delight&r: fruta do coro e pratos do End.", "&eTwilight Delight&r: comidas da Twilight Forest."]
	quest.7CE52A154AEA62ED.title: "Cortadora do Create"
	quest.7CE52A154AEA62ED.quest_subtitle: "Slice & Dice"
	quest.7CE52A154AEA62ED.quest_desc: ["A &ecortadora&r faz o trabalho da tábua de corte com a rotação do Create. Dê uma &efaca&r para ela e mande os ingredientes por baixo.", "", "O &easpersor&r embaixo de um cano com água molha a plantação. Segure &eW&r em cima das peças para ver a animação."]
	quest.7D237BC6C11B4564.title: "Cozinha automática"
	quest.7D237BC6C11B4564.quest_subtitle: "Create: Central Kitchen"
	quest.7D237BC6C11B4564.quest_desc: ["Com o &eCentral Kitchen&r, as máquinas do Create (braço mecânico, depositante) cozinham as receitas do Farmer's Delight sozinhas.", "", "Um &equeimador de blaze&r embaixo da panela acelera o cozimento. Segure &eW&r nos itens para ver como montar."]
	quest.12B3F56B552344DD.title: "Plantar minério"
	quest.12B3F56B552344DD.quest_subtitle: "Mystical Agriculture"
	quest.12B3F56B552344DD.quest_desc: ["O &eMystical Agriculture&r planta minério como se fosse trigo.", "", "Comece minerando &einferium&r nas cavernas. A essência dele faz as primeiras sementes. Veja o caminho todo com &eU&r em cima da essência."]
	chapter.1CC3B8CA7BE5A04E.title: "Construir"
	quest.379468DB3455A8B2.title: "Ferramenta de construir"
	quest.379468DB3455A8B2.quest_desc: ["Building Gadgets: coloca varios blocos de uma vez. Precisa de energia (carregue em um carregador de energia)."]
	quest.09486C4E6AFA0424.title: "Copiar e colar"
	quest.09486C4E6AFA0424.quest_desc: ["Copia uma area e cola em outro lugar, gastando os blocos do seu inventario."]
	quest.0F7DF596AAA40A64.title: "Construir com espelho"
	quest.0F7DF596AAA40A64.quest_desc: ["Effortless Building: segure Alt para escolher modos como parede, linha, espelho e repeticao."]
	quest.168A3A22661A0A48.title: "Telhados de verdade"
	quest.168A3A22661A0A48.quest_desc: ["Macaw's Roofs, Windows, Doors, Fences e Furniture: blocos de telhado, janelas, portas, cercas e moveis. Procure por mcw no JEI."]
	quest.14BD5A02E592B8A1.title: "Moveis"
	quest.14BD5A02E592B8A1.quest_desc: ["Handcrafted, Beautify, Supplementaries e Bubblellaneous trazem moveis e decoracao. Procure pelo nome do mod no JEI com @."]
	chapter.0681A168F2C7C697.title: "Animais"
	quest.709A1A630889A48A.title: "Dicionario animal"
	quest.709A1A630889A48A.quest_desc: ["Alex's Mobs tem um livro que explica cada bicho, o que ele come e como domesticar."]
	quest.06C980678102C2D1.title: "Banana"
	quest.06C980678102C2D1.quest_desc: ["Bananas caem das folhas de selva. Varios bichos do Alex's Mobs gostam delas, como os macacos."]
	quest.4ADAEBCD1EB47A95.title: "Hamster"
	quest.4ADAEBCD1EB47A95.quest_desc: ["Adorable Hamster Pets: hamsters de estimacao que seguem voce e cabem no ombro."]
	quest.11870977C3D93740.title: "Dragao"
	quest.11870977C3D93740.quest_desc: ["Dragon Mounts: ovos de dragao chocam um dragao que voce cria e monta."]
	quest.673908041A368C98.title: "Mais bichos"
	quest.673908041A368C98.quest_desc: ["Naturalist, Critters and Companions, Friends&Foes, Wilder Nature e Archie's Dinosaurs espalham bichos pelos biomas. O Jade mostra o nome de cada um."]
	chapter.2BBF7954E151BB6E.title: "Explorar"
	quest.076BEA6CFE9209A1.title: "Bussola de biomas"
	quest.076BEA6CFE9209A1.quest_desc: ["Nature's Compass aponta para o bioma que voce escolher."]
	quest.3062EA0B7042C34D.title: "Bussola de estruturas"
	quest.3062EA0B7042C34D.quest_desc: ["Explorer's Compass aponta para vilas, templos, masmorras e outras estruturas."]
	quest.333B894B34D3932D.title: "Atlas"
	quest.333B894B34D3932D.quest_desc: ["Map Atlases junta mapas de papel em um livro. Na mao secundaria vira minimapa."]
	quest.6181CF23667BE12E.title: "Pergaminho de volta"
	quest.6181CF23667BE12E.quest_desc: ["O pergaminho de retorno leva de volta para a ultima waystone ou cama."]
	chapter.59AADA362CD5A80D.title: "Mekanism"
	quest.790F2B514D6ED05C.title: "Infusor metalurgico"
	quest.790F2B514D6ED05C.quest_desc: ["A primeira maquina: mistura ferro com carvao para fazer aco e outras ligas. Precisa de energia."]
	quest.28B3969DA2CBC5F3.title: "Energia"
	quest.28B3969DA2CBC5F3.quest_desc: ["O Mekanism do pack nao tem geradores proprios: o alternador do Create Crafts & Additions transforma a rotacao do Create em energia para as maquinas."]
	quest.453A0736B216E094.title: "Camara de enriquecimento"
	quest.453A0736B216E094.quest_desc: ["Transforma um minerio em dois montes de po: o dobro de lingotes."]
	quest.193CC4C2D0BF0A31.title: "Cabos"
	quest.193CC4C2D0BF0A31.quest_desc: ["Cabos universais levam energia do gerador para as maquinas."]
	chapter.3AFA20A348928003.title: "Dimensoes"
	quest.29026A4FF6CEB946.title: "Nether"
	quest.29026A4FF6CEB946.quest_desc: ["Portal de obsidiana aceso com isqueiro."]
	quest.7155CC138F6A4CDC.title: "Aether"
	quest.7155CC138F6A4CDC.quest_desc: ["O ceu do Minecraft: moldura de pedra luminosa (glowstone) acesa com um balde de agua."]
	quest.2F383471F920B013.title: "Twilight Forest"
	quest.2F383471F920B013.quest_desc: ["Poca de agua 2x2 cercada de flores; jogue um diamante dentro."]
	quest.7B3BE44F6DE1B8AD.title: "Undergarden"
	quest.7B3BE44F6DE1B8AD.quest_desc: ["Moldura de tijolos de pedra ativada com o catalisador do Undergarden (receita no JEI)."]
	quest.132C1D9BA47BE4F2.title: "Eternal Starlight"
	quest.132C1D9BA47BE4F2.quest_desc: ["Dimensao das estrelas: procure as ruinas de portal pelo mundo e veja no JEI como ativar."]
	quest.12578001AE3297C2.title: "Masmorras infinitas"
	quest.12578001AE3297C2.quest_desc: ["Dimensional Dungeons: a chave de portal abre masmorras que se renovam (receita no JEI)."]
	quest.009843D988A83261.title: "Lua"
	quest.009843D988A83261.quest_desc: ["Ad Astra: monte um foguete na bancada da NASA e voe para a Lua."]
	quest.78BEFEA816B93AB6.title: "End"
	quest.78BEFEA816B93AB6.quest_desc: ["Olhos de ender levam ao portal do End e ao dragao."]
	chapter.62BEA1E66A80BAE3.title: "Aether"
	quest.6B1A452EC3CA1779.title: "Chegar no Aether"
	quest.6B1A452EC3CA1779.quest_desc: ["Moldura de glowstone acesa com um balde de agua. Leve o paraquedas dourado que o mod da na primeira visita."]
	quest.0D2620E5B1473973.title: "Ambrosium"
	quest.0D2620E5B1473973.quest_desc: ["Fragmentos de ambrosium curam e servem de combustivel no Aether."]
	quest.3B79E945D837AB5A.title: "Zanite"
	quest.3B79E945D837AB5A.quest_desc: ["Gema azul para ferramentas e armadura do Aether."]
	quest.3EDEF2172CD2B905.title: "Primeira masmorra"
	quest.3EDEF2172CD2B905.quest_desc: ["Venca o Slider na masmorra de bronze e pegue a chave de bronze."]
	quest.4AF87777C727F2E1.title: "Rainha Valquiria"
	quest.4AF87777C727F2E1.quest_desc: ["A masmorra de prata guarda a Rainha Valquiria e a chave de prata."]
	quest.2696EF3E0D6E89B7.title: "Espirito do Sol"
	quest.2696EF3E0D6E89B7.quest_desc: ["A masmorra de ouro e o fim do Aether: venca o Espirito do Sol."]
	chapter.58CDF0B4C55394C9.title: "Twilight Forest"
	quest.020B1BDC21D32332.title: "Entrar"
	quest.020B1BDC21D32332.quest_desc: ["Poca de agua 2x2 cercada de flores; jogue um diamante dentro."]
	quest.7DF21F3AFD83BEBE.title: "Naga"
	quest.7DF21F3AFD83BEBE.quest_desc: ["O primeiro chefe vive no patio de pedra. Ele deixa escamas para armadura."]
	quest.3C11C6E6C0EA5EDF.title: "Mapa magico"
	quest.3C11C6E6C0EA5EDF.quest_desc: ["Com o foco de mapa magico voce faz um mapa que mostra os biomas e as estruturas dos chefes."]
	quest.40E733CE9055A8C2.title: "Proximos chefes"
	quest.40E733CE9055A8C2.quest_desc: ["A progressao segue: Lich, Hidra, Ur-Ghast e outros. Cada chefe libera a regiao seguinte; tentar pular da efeitos ruins."]
	chapter.52600FF197F42E06.title: "Undergarden"
	quest.49ABA829AA40AE05.title: "Catalisador"
	quest.49ABA829AA40AE05.quest_desc: ["O catalisador ativa o portal de tijolos de pedra."]
	quest.7F65FA3D01E0FE56.title: "Entrar"
	quest.7F65FA3D01E0FE56.quest_desc: ["Undergarden e um mundo escuro e perigoso embaixo da terra. Leve tochas."]
	quest.09912EE1CD8CCEEA.title: "Cloggrum"
	quest.09912EE1CD8CCEEA.quest_desc: ["O primeiro metal do Undergarden, para ferramentas."]
	quest.2B4732C93C19A1AF.title: "Froststeel"
	quest.2B4732C93C19A1AF.quest_desc: ["Metal gelado que deixa os inimigos mais lentos."]
	quest.492E6A440E59C51C.title: "Utherium"
	quest.492E6A440E59C51C.quest_desc: ["Cristal forte contra as criaturas do Undergarden."]
	chapter.6CDFF22C3CFE2200.title: "Espaco"
	quest.5AD3F903CD78E4F3.title: "Aco"
	quest.5AD3F903CD78E4F3.quest_desc: ["Ad Astra comeca com aco."]
	quest.78643149D88DB1BF.title: "Bancada da NASA"
	quest.78643149D88DB1BF.quest_desc: ["A bancada da NASA monta as pecas do foguete."]
	quest.7B3831876F704DD4.title: "Traje espacial"
	quest.7B3831876F704DD4.quest_desc: ["Capacete e traje espacial com oxigenio sao obrigatorios fora da Terra."]
	quest.1E0708B7EA09C5FA.title: "Foguete"
	quest.1E0708B7EA09C5FA.quest_desc: ["Foguete nivel 1: leva ate a Lua. Abasteca com combustivel e coloque na plataforma de lancamento."]
	quest.72366A0DEA4B1515.title: "Lua"
	quest.72366A0DEA4B1515.quest_desc: ["Na Lua tem desh, o metal do foguete seguinte."]
	quest.4A989F85660C8492.title: "Desh"
	quest.4A989F85660C8492.quest_desc: ["Com desh voce faz o foguete nivel 2 e chega em Marte."]
	quest.6C64252B40CD4F10.title: "Marte"
	quest.6C64252B40CD4F10.quest_desc: ["Marte e o caminho para Venus, Mercurio e Glacio."]
	quest.425B42F224DFA666.title: "Venus"
	quest.425B42F224DFA666.quest_desc: ["Venus e quente e acida: va com o traje certo."]
	quest.07CDDF90A2B8F066.title: "Mercurio"
	quest.07CDDF90A2B8F066.quest_desc: ["O planeta mais perto do Sol."]
	quest.6D006D3D25BE95FA.title: "Glacio"
	quest.6D006D3D25BE95FA.quest_desc: ["O planeta gelado, o mais longe de todos."]
	quest.624E7920FAAD6862.title: "Vila lunar"
	quest.624E7920FAAD6862.quest_desc: ["Os lunarianos tem vilas na Lua e trocam itens como os aldeoes."]
	chapter.1EDB32752725DDCA.title: "Utilidades"
	quest.493065C7669E9089.title: "Minerar em bloco"
	quest.493065C7669E9089.quest_desc: ["VeinMiner: segure a tecla ao lado do 1 e quebre um minerio para levar o veio inteiro."]
	quest.6469C52CE8ED6032.title: "Marcar no mapa"
	quest.6469C52CE8ED6032.quest_desc: ["Ping Wheel: o botao do meio do mouse marca um ponto para todo mundo ver."]
	quest.114B01E7B50BF062.title: "Carregar bau"
	quest.114B01E7B50BF062.quest_desc: ["Carry On: agache com a mao vazia e clique em um bau para levar ele inteiro, com tudo dentro."]
	quest.44D6D9BE5B35C3AF.title: "Martelo"
	quest.44D6D9BE5B35C3AF.quest_desc: ["Just Hammers: o martelo quebra uma area 3x3 de uma vez."]
	quest.1DF15A7537E1459C.title: "Saco de dormir"
	quest.1DF15A7537E1459C.quest_desc: ["Comforts: o saco de dormir passa a noite sem mudar o seu ponto de nascer."]
	quest.051B132375F0969D.title: "Zoom"
	quest.051B132375F0969D.quest_desc: ["Ok Zoomer: segure C para dar zoom; a roda do mouse ajusta."]
	quest.737CADF831F74384.title: "Baus de saque"
	quest.737CADF831F74384.quest_desc: ["Lootr: cada jogador abre o seu proprio saque nos baus das estruturas. Ninguem fica sem."]
	quest.2C23A23D6D3A08C6.title: "Terminal de armazenamento"
	quest.2C23A23D6D3A08C6.quest_desc: ["Tom's Storage: liga varios baus em um terminal so, com busca."]
	quest.205E6C0F5C30753E.title: "Netherite melhor"
	quest.205E6C0F5C30753E.quest_desc: ["Advanced Netherite: ferramentas e armaduras alem da netherite, com ferro, ouro, esmeralda e diamante."]
	quest.08B06B2679D02B1D.title: "Fumar"
	quest.08B06B2679D02B1D.quest_desc: ["Smoking Pipe, CiggyCraft e Tobacconist: plante tabaco e fume. So por diversao."]
	chapter.352FDEAA5730E688.title: "Create: addons"
	quest.07F95DF54233143C.title: "Jetpack"
	quest.07F95DF54233143C.quest_desc: ["Create Jetpack: voa com ar comprimido de um tanque."]
	quest.38B4B8D64B859B04.title: "Escavadeira de minerio"
	quest.38B4B8D64B859B04.quest_desc: ["Create Ore Excavation: maquinas que extraem minerio de veios infinitos no subsolo."]
	quest.6B817114074B4272.title: "Encantar com maquina"
	quest.6B817114074B4272.quest_desc: ["Create Enchantment Industry: transforma experiencia em liquido e encanta itens com maquinas."]
	quest.325CB21188010A9A.title: "Energia"
	quest.325CB21188010A9A.quest_desc: ["Create Crafts & Additions: o alternador gera energia e o motor eletrico gira as maquinas."]
	quest.577B50F4C3ED884A.title: "Cozinha automatica"
	quest.577B50F4C3ED884A.quest_desc: ["Create Central Kitchen: as maquinas do Create fazem as comidas do Farmer's Delight."]
	chapter.671D011D2029328F.title: "Cacador de chefes"
	quest.62726123703DF347.title: "Wither"
	quest.62726123703DF347.quest_desc: ["Tres cranios de esqueleto wither em cima de areia das almas em T. Faca longe de casa."]
	quest.14A09DB6CD3C9668.title: "Dragao do Ender"
	quest.14A09DB6CD3C9668.quest_desc: ["O chefe do End."]
	quest.3B675ADFEB3DC4A5.title: "Warden"
	quest.3B675ADFEB3DC4A5.quest_desc: ["Mora nas cidades antigas do subsolo escuro. Sem barulho, ele nao aparece."]
	quest.542C1529514AFB08.title: "Guardiao anciao"
	quest.542C1529514AFB08.quest_desc: ["Mora no monumento do oceano."]
	quest.6EAA7D65C829EAEC.title: "Cavaleiro de ferro"
	quest.6EAA7D65C829EAEC.quest_desc: ["Mowzie's Mobs: o Ferrous Wroughtnaut guarda uma camara no subsolo. Acerte as costas depois que ele erra o golpe."]
	quest.0D06AEA7DF8858A2.title: "Frostmaw"
	quest.0D06AEA7DF8858A2.quest_desc: ["Mowzie's Mobs: um gigante de gelo que dorme nos biomas de neve."]
	quest.308D71C4D5520C9A.title: "Umvuthi"
	quest.308D71C4D5520C9A.quest_desc: ["Mowzie's Mobs: o passaro do sol que lidera o povo da savana."]
	quest.36E81DAF9E4A2C77.title: "Escultor"
	quest.36E81DAF9E4A2C77.quest_desc: ["Mowzie's Mobs: Tongbi, o Escultor, no topo do monasterio nas montanhas."]
	quest.0E303137846E5107.title: "Capita Cornelia"
	quest.0E303137846E5107.quest_desc: ["Aquamirae: o fantasma da capita nos navios piratas do oceano gelado."]
	quest.6A04EA7B733F51D5.title: "Maw"
	quest.6A04EA7B733F51D5.quest_desc: ["Aquamirae: monstro das aguas geladas."]
	quest.657F017E8BAA19B7.title: "Guardiao esquecido"
	quest.657F017E8BAA19B7.quest_desc: ["Undergarden: o chefe das catacumbas."]
	quest.08B95201CB94C70C.title: "Guardiao do portao"
	quest.08B95201CB94C70C.quest_desc: ["Eternal Starlight: The Gatekeeper."]
	quest.0264C648566DCAFE.title: "Golem estelar"
	quest.0264C648566DCAFE.quest_desc: ["Eternal Starlight: o golem da forja."]
	quest.69CAAB8AFFAD3256.title: "Monstro lunar"
	quest.69CAAB8AFFAD3256.quest_desc: ["Eternal Starlight: a Lunar Monstrosity."]
	chapter.00768C72EAFD4EA3.title: "Chefes da Twilight"
	quest.6490CA6149519CDC.title: "Naga"
	quest.6490CA6149519CDC.quest_desc: ["O primeiro chefe, no patio de pedra."]
	quest.116977F2BD1CE274.title: "Lich"
