	quest.29026A4FF6CEB946.title: "Nether"
	quest.29026A4FF6CEB946.quest_desc: ["Portal de obsidiana aceso com isqueiro."]
	quest.7155CC138F6A4CDC.title: "Aether"
	quest.7155CC138F6A4CDC.quest_desc: ["O ceu do Minecraft: moldura de pedra luminosa (glowstone) acesa com um balde de agua."]
	quest.2F383471F920B013.title: "Twilight Forest"
	quest.2F383471F920B013.quest_desc: ["Poca de agua 2x2 cercada de flores; jogue um diamante dentro."]
	quest.7B3BE44F6DE1B8AD.title: "Undergarden"
	quest.7B3BE44F6DE1B8AD.quest_desc: ["Moldura de tijolos de pedra ativada com o catalisador do Undergarden (receita no JEI)."]
	quest.932C1D9BA47BE4F2.title: "Eternal Starlight"
	quest.932C1D9BA47BE4F2.quest_desc: ["Dimensao das estrelas: procure as ruinas de portal pelo mundo e veja no JEI como ativar."]
	quest.12578001AE3297C2.title: "Masmorras infinitas"
	quest.12578001AE3297C2.quest_desc: ["Dimensional Dungeons: a chave de portal abre masmorras que se renovam (receita no JEI)."]
	quest.009843D988A83261.title: "Lua"
	quest.009843D988A83261.quest_desc: ["Ad Astra: monte um foguete na bancada da NASA e voe para a Lua."]
	quest.F8BEFEA816B93AB6.title: "End"
	quest.F8BEFEA816B93AB6.quest_desc: ["Olhos de ender levam ao portal do End e ao dragao."]
