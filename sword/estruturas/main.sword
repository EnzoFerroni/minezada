// estruturas: as estruturas que ja apareceram numa dimensao, num JSON para o mapa da pagina.
//
//   estruturas <pasta da dimensao> <saida.json>
//
// Le <pasta>/region/r.X.Z.mca e escreve {"estruturas": [{id, x, z}, ...]}, so as dos chunks completos, em ordem
// de x, z e id. Vem todas, do jogo e dos mods; quais aparecem no mapa, e com que nome, a pagina decide. Cada
// regiao e lida num pedaco proprio de uma memoria so, todas ao mesmo tempo, como no mapa.

import "std/bytes"
import "std/fs"
import "std/io"
import "std/json"
import "std/mem"
import "std/os"
import "std/strings"
import "minezada/mundo"

const PerRegion = 2048

func less(a string, b string) bool {
    mut i u64 = 0
    for i < a.len && i < b.len {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
        i += 1
    }
    return a.len < b.len
}

func before(a *mundo.Start, b *mundo.Start) bool {
    if a.X != b.X {
        return a.X < b.X
    }
    if a.Z != b.Z {
        return a.Z < b.Z
    }
    return less(a.Name(), b.Name())
}

func main() !int {
    mut room := [4]string{}
    args := os.Args(room[..])
    if args.len != 3 {
        try io.Print("uso: estruturas <pasta da dimensao> <saida.json>\n")
        return 2
    }
    mut sys := mem.NewSystem()
    dir := try strings.Concat(&sys, args[1], "/region")
    none := [0]fs.Entry{}
    entries := fs.ReadDir(dir, &sys) catch none[..]
    mut paths := mem.Alloc[string](&sys, entries.len + 1) orelse return error.OutOfMemory
    mut n u64 = 0
    for e in entries {
        if !e.IsDir && strings.HasPrefix(e.Name, "r.") && strings.HasSuffix(e.Name, ".mca") {
            paths[n] = try strings.Concat(&sys, dir, "/", e.Name)
            n += 1
        }
    }
    files := paths[0..n]

    // Um pedaco por regiao: as estruturas e, no fim, quantas (Len 9999 se a regiao falhou). O pedaco a mais, sem
    // regiao, fica vazio; ele so deixa a memoria com algum tamanho quando n e 0.
    piece := u64(PerRegion) + 1
    mut all := mem.Alloc[mundo.Start](&sys, (n + 1) * piece) orelse return error.OutOfMemory
    parallel for off, part in all.chunks(piece) {
        k := off / piece
        mut got u64 = 0
        if k < files.len {
            got = mundo.Starts(files[k], part[0..PerRegion]) catch 9999
        }
        part[PerRegion] = mundo.Start{X: 0, Z: 0, Id: [64]u8{}, Len: got}
    }
    mut found := mem.Alloc[mundo.Start](&sys, n * PerRegion + 1) orelse return error.OutOfMemory
    mut m u64 = 0
    mut failed u64 = 0
    for k in 0..n {
        got := all[k * piece + PerRegion].Len
        if got > PerRegion {
            failed += 1
            try io.Printf("AVISO: regiao {} nao foi lida\n", files[k])
            continue
        }
        for i in 0..got {
            found[m] = all[k * piece + i]
            m += 1
        }
    }
    for i in 1..m {
        mut j := i
        for j > 0 && before(&found[j], &found[j - 1]) {
            tmp := found[j]
            found[j] = found[j - 1]
            found[j - 1] = tmp
            j -= 1
        }
    }

    mut out := try bytes.New(&sys, 4096)
    mut w := json.NewWriter(&out)
    w.BeginObject()
    w.Key("estruturas")
    w.BeginArray()
    for i in 0..m {
        w.BeginObject()
        w.Key("id")
        w.Str(found[i].Name())
        w.Key("x")
        w.Int(found[i].X)
        w.Key("z")
        w.Int(found[i].Z)
        w.EndObject()
    }
    w.EndArray()
    w.EndObject()
    try w.Err()
    try out.WriteByte(10)
    try fs.WriteAll(args[2], out.Bytes())
    try io.Printf("{} estruturas\n", m)
    if failed > 0 {
        return 1
    }
    return 0
}
