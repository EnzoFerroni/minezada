// historico: resume o historico do selo num JSON para a pagina.
//
//   historico <historico.txt> <saida.json> [dias]
//
// Uma entrada por dia dos ultimos `dias` (30 sem dizer), do mais antigo ao de hoje, mesmo os dias sem ninguem:
// a pagina desenha uma barra por dia.

import "std/bytes"
import "std/fs"
import "std/io"
import "std/json"
import "std/mem"
import "std/os"
import "std/strings"
import "minezada/hist"

func pad(mut b *bytes.Buffer, v i64, width u64) !void {
    mut n u64 = 1
    mut x := v / 10
    for x > 0 {
        n += 1
        x = x / 10
    }
    for _ in n..width {
        try b.WriteByte(48)
    }
    try b.WriteU64(u64(v))
}

func date(mut b *bytes.Buffer, days i64) !void {
    d := hist.CivilFromDays(days)
    try pad(b, d.Year, 4)
    try b.WriteByte(45)
    try pad(b, d.Month, 2)
    try b.WriteByte(45)
    try pad(b, d.Day, 2)
}

func main() !int {
    mut room := [4]string{}
    args := os.Args(room[..])
    if args.len != 3 && args.len != 4 {
        try io.Print("uso: historico <historico.txt> <saida.json> [dias]\n")
        return 2
    }
    mut want u64 = 30
    if args.len == 4 {
        want = strings.ParseU64(args[3]) catch 0
        if want == 0 || want > 3660 {
            try io.Print("dias: de 1 a 3660\n")
            return 2
        }
    }
    mut sys := mem.NewSystem()
    text := string(try fs.ReadAll(args[1], &sys))

    mut lines u64 = 0
    for i in 0..text.len {
        if text[i] == 10 {
            lines += 1
        }
    }
    mut samples := mem.Alloc[hist.Sample](&sys, lines + 1) orelse return error.OutOfMemory
    mut n u64 = 0
    mut bad u64 = 0
    mut last := ""
    mut start u64 = 0
    for i in 0..text.len + 1 {
        if i < text.len && text[i] != 10 {
            continue
        }
        line := text[start..i]
        start = i + 1
        if line.len == 0 {
            continue
        }
        s := hist.Parse(line) catch {
            bad += 1
            continue
        }
        samples[n] = s
        n += 1
        if s.Online {
            last = line[0..20]
        }
    }
    if bad > 0 {
        try io.Printf("AVISO: {} linhas fora do formato ignoradas\n", bad)
    }

    mut out := try bytes.New(&sys, 4096)
    mut w := json.NewWriter(&out)
    w.BeginObject()
    w.Key("ligado_agora")
    w.Bool(n > 0 && samples[n - 1].Online)
    w.Key("ultimo_ligado")
    if last.len > 0 {
        w.Str(last)
    } else {
        w.Null()
    }
    mut total i64 = 0
    w.Key("dias")
    w.BeginArray()
    if n > 0 {
        today := hist.LocalDay(samples[n - 1].Unix)
        first := today - i64(want) + 1
        mut days := mem.Alloc[hist.Day](&sys, want) orelse return error.OutOfMemory
        hist.Sum(samples[0..n], first, days)
        for d in days {
            total += d.Seconds
            mut day := try bytes.New(&sys, 10)
            try date(&day, d.Days)
            w.BeginObject()
            w.Key("dia")
            w.Str(day.Str())
            w.Key("horas")
            w.Number(f64(d.Seconds) / 3600.0, 1)
            w.Key("pico")
            w.Int(d.Peak)
            w.EndObject()
        }
    }
    w.EndArray()
    w.Key("horas")
    w.Number(f64(total) / 3600.0, 1)
    w.EndObject()
    try w.Err()
    try out.WriteByte(10)
    try fs.WriteAll(args[2], out.Bytes())
    return 0
}
