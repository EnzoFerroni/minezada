package mundo

import "std/strings"

// A cor de um bloco visto de cima, 0xRRGGBB. Primeiro os blocos mais comuns pelo nome exato, depois pedacos do
// nome, que pegam tambem os blocos dos mods (quase todo mod chama folha de "leaves" e tronco de "log"). O que
// sobra fica cinza. Grama, folhas e agua ganham depois a cor do bioma (TintOf, BiomeTints).
func ColorOf(full string) u32 {
    i := strings.IndexByte(full, 58)
    mut n := full
    if i < full.len {
        n = full[i + 1..]
    }
    if strings.Equal(n, "grass_block") { return 0x6f9a3c }
    if strings.Equal(n, "short_grass") || strings.Equal(n, "tall_grass") || strings.Equal(n, "fern") || strings.Equal(n, "large_fern") { return 0x6b9b37 }
    if strings.Equal(n, "dirt") || strings.Equal(n, "coarse_dirt") || strings.Equal(n, "rooted_dirt") { return 0x8b6646 }
    if strings.Equal(n, "podzol") { return 0x7a5530 }
    if strings.Equal(n, "mycelium") { return 0x76666f }
    if strings.Equal(n, "dirt_path") { return 0x9a7f4c }
    if strings.Equal(n, "farmland") { return 0x7d5a3a }
    if strings.Equal(n, "mud") { return 0x3c3a3d }
    if strings.Equal(n, "clay") { return 0xa1a6b4 }
    if strings.Equal(n, "gravel") { return 0x857f7c }
    if strings.Equal(n, "red_sand") { return 0xbe6621 }
    if strings.Equal(n, "calcite") { return 0xdfe0dc }
    if strings.Equal(n, "granite") { return 0x95674f }
    if strings.Equal(n, "diorite") { return 0xbcbcbc }
    if strings.Equal(n, "andesite") { return 0x888888 }
    if strings.Equal(n, "tuff") { return 0x6c6c5f }
    if strings.Equal(n, "netherrack") { return 0x6f3534 }
    if strings.Equal(n, "end_stone") { return 0xdbde9e }
    if strings.Equal(n, "obsidian") { return 0x1a1527 }
    if strings.Equal(n, "bedrock") { return 0x555555 }
    if strings.Equal(n, "pumpkin") { return 0xc87818 }
    if strings.Equal(n, "melon") { return 0x7a9b2a }
    if strings.Equal(n, "cactus") { return 0x5a8a2c }
    if strings.Equal(n, "bamboo") { return 0x5d8a26 }
    if strings.Equal(n, "sugar_cane") { return 0x8fbf5a }
    if strings.Equal(n, "wheat") || strings.Equal(n, "carrots") || strings.Equal(n, "potatoes") { return 0xa8a23c }
    if strings.Equal(n, "cherry_leaves") { return 0xe8b0c4 }
    if strings.Equal(n, "birch_leaves") { return 0x6f9a45 }
    if strings.Equal(n, "spruce_leaves") { return 0x3d5e3a }
    if strings.Equal(n, "azalea_leaves") || strings.Equal(n, "flowering_azalea_leaves") { return 0x5f7a2e }

    if strings.Contains(n, "water") || strings.Contains(n, "kelp") || strings.Contains(n, "seagrass") || strings.Contains(n, "bubble") { return 0x3f6fd8 }
    if strings.Contains(n, "lava") || strings.Contains(n, "magma") { return 0xd25a12 }
    if strings.Contains(n, "snow") || strings.Contains(n, "powder") { return 0xf4f8fa }
    if strings.Contains(n, "ice") { return 0x9cb8f0 }
    if strings.Contains(n, "leaves") || strings.Contains(n, "moss") || strings.Contains(n, "vine") || strings.Contains(n, "bush") || strings.Contains(n, "sapling") || strings.Contains(n, "lily") { return 0x3f7a2a }
    if strings.Contains(n, "grass") || strings.Contains(n, "fern") || strings.Contains(n, "flower") || strings.Contains(n, "tulip") || strings.Contains(n, "orchid") || strings.Contains(n, "daisy") || strings.Contains(n, "poppy") || strings.Contains(n, "dandelion") || strings.Contains(n, "allium") || strings.Contains(n, "bluet") || strings.Contains(n, "lilac") || strings.Contains(n, "peony") || strings.Contains(n, "rose") { return 0x6b9b37 }
    if strings.Contains(n, "sandstone") { return 0xd8c98f }
    if strings.Contains(n, "sand") { return 0xe3d6a0 }
    if strings.Contains(n, "terracotta") { return dyed(n, 0x9e624b) }
    if strings.Contains(n, "wool") || strings.Contains(n, "concrete") || strings.Contains(n, "carpet") || strings.Contains(n, "glass") { return dyed(n, 0xd8dde0) }
    if strings.Contains(n, "planks") || strings.Contains(n, "slab") || strings.Contains(n, "stairs") || strings.Contains(n, "fence") || strings.Contains(n, "door") || strings.Contains(n, "chest") || strings.Contains(n, "barrel") || strings.Contains(n, "crafting") { return 0xa2824e }
    if strings.Contains(n, "log") || strings.Contains(n, "wood") || strings.Contains(n, "stem") || strings.Contains(n, "hyphae") { return 0x6b5332 }
    if strings.Contains(n, "dirt") || strings.Contains(n, "soil") || strings.Contains(n, "mud") { return 0x8b6646 }
    if strings.Contains(n, "deepslate") || strings.Contains(n, "basalt") || strings.Contains(n, "blackstone") { return 0x585860 }
    if strings.Contains(n, "stone") || strings.Contains(n, "cobble") || strings.Contains(n, "brick") || strings.Contains(n, "ore") || strings.Contains(n, "rock") { return 0x7d7d7d }
    return 0x9a9a9a
}

// Lã, concreto, vidro e terracota tingidos: a cor do corante no comeco do nome.
func dyed(n string, plain u32) u32 {
    if strings.HasPrefix(n, "white") { return 0xe9ecec }
    if strings.HasPrefix(n, "orange") { return 0xf07613 }
    if strings.HasPrefix(n, "magenta") { return 0xbd44b3 }
    if strings.HasPrefix(n, "light_blue") { return 0x3aafd9 }
    if strings.HasPrefix(n, "yellow") { return 0xf8c527 }
    if strings.HasPrefix(n, "lime") { return 0x70b919 }
    if strings.HasPrefix(n, "pink") { return 0xed8dac }
    if strings.HasPrefix(n, "light_gray") { return 0x8e8e86 }
    if strings.HasPrefix(n, "gray") { return 0x3e4447 }
    if strings.HasPrefix(n, "cyan") { return 0x158991 }
    if strings.HasPrefix(n, "purple") { return 0x792aac }
    if strings.HasPrefix(n, "blue") { return 0x35399d }
    if strings.HasPrefix(n, "brown") { return 0x724728 }
    if strings.HasPrefix(n, "green") { return 0x546d1b }
    if strings.HasPrefix(n, "red") { return 0xa12722 }
    if strings.HasPrefix(n, "black") { return 0x141519 }
    return plain
}

// Ar de qualquer tipo: o das cavernas e o do vazio tambem.
func isAir(full string) bool {
    return strings.Equal(full, "minecraft:air") || strings.Equal(full, "minecraft:cave_air") || strings.Equal(full, "minecraft:void_air")
}

// Agua e lava sao vistas pela cor delas, e o resto pelo bloco de cima.
func isWater(full string) bool {
    return strings.Contains(full, "water") || strings.Contains(full, "kelp") || strings.Contains(full, "seagrass") || strings.Contains(full, "bubble_column")
}

// Blocos que o jogo pinta com a cor do bioma: a grama, as folhas das arvores comuns e a agua. Folha de pinheiro,
// de betula e de cerejeira tem cor propria e fica de fora, como no jogo.
const Grass = 1
const Foliage = 2
const Water = 3

func TintOf(full string) u8 {
    if isWater(full) {
        return Water
    }
    i := strings.IndexByte(full, 58)
    mut n := full
    if i < full.len {
        n = full[i + 1..]
    }
    if !strings.HasPrefix(full, "minecraft:") {
        return 0
    }
    if strings.Equal(n, "grass_block") || strings.Equal(n, "short_grass") || strings.Equal(n, "tall_grass") || strings.Equal(n, "fern") || strings.Equal(n, "large_fern") {
        return Grass
    }
    if strings.Equal(n, "oak_leaves") || strings.Equal(n, "jungle_leaves") || strings.Equal(n, "acacia_leaves") || strings.Equal(n, "dark_oak_leaves") || strings.Equal(n, "mangrove_leaves") || strings.Equal(n, "vine") {
        return Foliage
    }
    return 0
}

struct Tints {
    Grass   u32
    Foliage u32
    Water   u32
}

// As cores de grama, folha e agua de um bioma. Os do jogo e os de mod (o Terralith tem dezenas) entram pelo
// nome: um bioma "snowy", "frozen" ou "alpine" e frio, "swamp" ou "bog" e pantano, e assim por diante. O resto
// fica com as cores de uma planicie.
func BiomeTints(full string) Tints {
    i := strings.IndexByte(full, 58)
    mut n := full
    if i < full.len {
        n = full[i + 1..]
    }
    mut water u32 = 0x3f76e4
    if strings.Contains(n, "warm_ocean") {
        water = 0x43d5ee
    } else if strings.Contains(n, "lukewarm") {
        water = 0x45adf2
    } else if strings.Contains(n, "frozen") || strings.Contains(n, "ice") || strings.Contains(n, "snowy") || strings.Contains(n, "glacier") {
        water = 0x3938c9
    } else if strings.Contains(n, "cold") {
        water = 0x3d57d6
    }
    if strings.Contains(n, "swamp") || strings.Contains(n, "bog") || strings.Contains(n, "marsh") {
        return Tints{Grass: 0x6a7039, Foliage: 0x6a7039, Water: 0x617b64}
    }
    if strings.Contains(n, "mushroom") {
        return Tints{Grass: 0x55c93f, Foliage: 0x2bbb0f, Water: water}
    }
    if strings.Contains(n, "badlands") || strings.Contains(n, "mesa") {
        return Tints{Grass: 0x90814d, Foliage: 0x9e814d, Water: water}
    }
    if strings.Contains(n, "desert") || strings.Contains(n, "savanna") || strings.Contains(n, "arid") || strings.Contains(n, "dune") || strings.Contains(n, "steppe") {
        return Tints{Grass: 0xbfb755, Foliage: 0xaea42a, Water: water}
    }
    if strings.Contains(n, "jungle") || strings.Contains(n, "tropical") || strings.Contains(n, "rainforest") {
        return Tints{Grass: 0x59c93c, Foliage: 0x30bb0b, Water: water}
    }
    if strings.Contains(n, "snow") || strings.Contains(n, "frozen") || strings.Contains(n, "ice") || strings.Contains(n, "tundra") || strings.Contains(n, "alpine") || strings.Contains(n, "glacier") || strings.Contains(n, "cold") || strings.Contains(n, "grove") || strings.Contains(n, "peaks") {
        return Tints{Grass: 0x80b497, Foliage: 0x60a17b, Water: water}
    }
    if strings.Contains(n, "taiga") || strings.Contains(n, "spruce") || strings.Contains(n, "pine") || strings.Contains(n, "boreal") {
        return Tints{Grass: 0x86b783, Foliage: 0x68a464, Water: water}
    }
    if strings.Contains(n, "dark_forest") || strings.Contains(n, "roofed") {
        return Tints{Grass: 0x507a32, Foliage: 0x59ae30, Water: water}
    }
    if strings.Contains(n, "birch") {
        return Tints{Grass: 0x88bb67, Foliage: 0x6ba941, Water: water}
    }
    if strings.Contains(n, "cherry") || strings.Contains(n, "sakura") {
        return Tints{Grass: 0xb6db61, Foliage: 0xb6db61, Water: 0x5db7ef}
    }
    if strings.Contains(n, "forest") || strings.Contains(n, "woods") {
        return Tints{Grass: 0x79c05a, Foliage: 0x59ae30, Water: water}
    }
    return Tints{Grass: 0x91bd59, Foliage: 0x77ab2f, Water: water}
}

// A cor do bloco tingido visto de cima: a do bioma, escurecida pela textura (a grama e mais clara que a folha).
func Tinted(t Tints, kind u8) u32 {
    switch kind {
    case 1:
        return shade(t.Grass, 76)
    case 2:
        return shade(t.Foliage, 60)
    case 3:
        return shade(t.Water, 95)
    default:
        return 0
    }
}
