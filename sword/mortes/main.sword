// mortes: onde cada um morreu, num JSON para o mapa da pagina.
//
//   mortes <pasta do mundo> <saida.json>
//
// Le <mundo>/deaths/<jogador>/<morte>.dat, que o mod Corpse grava a cada morte (NBT sem compressao: nome, posicao,
// dimensao e hora; a causa ele nao guarda). Escreve {"mortes": [{nick, dimensao, x, y, z, quando_ms}, ...]}, da
// mais antiga para a mais nova. Sem a pasta (o mod saiu do pack, ou ninguem morreu), sai a lista vazia.

import "std/bytes"
import "std/fs"
import "std/io"
import "std/json"
import "std/mem"
import "std/os"
import "std/strings"
import "minezada/nbt"

struct Death {
    nick string
    dim  string
    x    i64
    y    i64
    z    i64
    when i64
}

func floor(v f64) i64 {
    t := i64(v)
    if f64(t) > v {
        return t - 1
    }
    return t
}

// A morte gravada em b; o nick e a dimensao sao pedacos de b.
func death(b []u8) !Death {
    root := try nbt.Root(b)
    return Death{
        nick: try nbt.Text(b, try nbt.Find(b, root, "PlayerName")),
        dim: try nbt.Text(b, try nbt.Find(b, root, "Dimension")),
        x: floor(try nbt.Real(b, try nbt.Find(b, root, "PosX"))),
        y: floor(try nbt.Real(b, try nbt.Find(b, root, "PosY"))),
        z: floor(try nbt.Real(b, try nbt.Find(b, root, "PosZ"))),
        when: try nbt.Number(b, try nbt.Find(b, root, "Timestamp")),
    }
}

// Mais antiga primeiro; na mesma hora, pelo nick, para a saida nao depender da ordem dos arquivos.
func before(a Death, b Death) bool {
    if a.when != b.when {
        return a.when < b.when
    }
    return less(a.nick, b.nick)
}

// a vem antes de b na ordem dos bytes.
func less(a string, b string) bool {
    mut i u64 = 0
    for i < a.len && i < b.len {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
        i += 1
    }
    return a.len < b.len
}

func main() !int {
    mut room := [4]string{}
    args := os.Args(room[..])
    if args.len != 3 {
        try io.Print("uso: mortes <pasta do mundo> <saida.json>\n")
        return 2
    }
    mut sys := mem.NewSystem()
    dir := try strings.Concat(&sys, args[1], "/deaths")
    none := [0]fs.Entry{}
    players := fs.ReadDir(dir, &sys) catch none[..]
    mut all := mem.Alloc[Death](&sys, 1 << 14) orelse return error.OutOfMemory
    mut n u64 = 0
    mut bad u64 = 0
    for p in players {
        if !p.IsDir {
            continue
        }
        sub := try strings.Concat(&sys, dir, "/", p.Name)
        files := fs.ReadDir(sub, &sys) catch none[..]
        for f in files {
            if f.IsDir || !strings.HasSuffix(f.Name, ".dat") || n == all.len {
                continue
            }
            data := fs.ReadAll(try strings.Concat(&sys, sub, "/", f.Name), &sys) catch |e| {
                try io.Printf("AVISO: {}/{} nao foi lido: {}\n", p.Name, f.Name, e.Message())
                bad += 1
                continue
            }
            all[n] = death(data) catch |e| {
                try io.Printf("AVISO: {}/{} nao foi lido: {}\n", p.Name, f.Name, e.Message())
                bad += 1
                continue
            }
            n += 1
        }
    }
    for i in 1..n {
        mut j := i
        for j > 0 && before(all[j], all[j - 1]) {
            tmp := all[j]
            all[j] = all[j - 1]
            all[j - 1] = tmp
            j -= 1
        }
    }

    mut out := try bytes.New(&sys, 4096)
    mut w := json.NewWriter(&out)
    w.BeginObject()
    w.Key("mortes")
    w.BeginArray()
    for i in 0..n {
        d := all[i]
        w.BeginObject()
        w.Key("nick")
        w.Str(d.nick)
        w.Key("dimensao")
        w.Str(d.dim)
        w.Key("x")
        w.Int(d.x)
        w.Key("y")
        w.Int(d.y)
        w.Key("z")
        w.Int(d.z)
        w.Key("quando_ms")
        w.Int(d.when)
        w.EndObject()
    }
    w.EndArray()
    w.EndObject()
    try w.Err()
    try out.WriteByte(10)
    try fs.WriteAll(args[2], out.Bytes())
    try io.Printf("{} mortes\n", n)
    if bad > 0 {
        return 1
    }
    return 0
}
